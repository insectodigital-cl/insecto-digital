    root.add(tabletGroup);

    // Screen bezel
    const bezel=new THREE.Mesh(new THREE.BoxGeometry(2.6,1.65,.06),new THREE.MeshStandardMaterial({color:0x111111,metalness:.85,roughness:.22}));
    tabletGroup.add(bezel);
    // Screen surface
    const screen=new THREE.Mesh(new THREE.PlaneGeometry(2.42,1.5),new THREE.MeshBasicMaterial({color:0x0a0620,transparent:true,opacity:.95}));
    screen.position.z=.032; tabletGroup.add(screen);
    // Screen glow
    const glow=new THREE.Mesh(new THREE.PlaneGeometry(2.44,1.52),new THREE.MeshBasicMaterial({color:0x9B5DFF,transparent:true,opacity:.06}));
    glow.position.z=.031; tabletGroup.add(glow);

    // ── UI ELEMENTS on screen ──
    // Title bar
    const titleBar=new THREE.Mesh(new THREE.PlaneGeometry(2.42,.12),new THREE.MeshBasicMaterial({color:0x16102a}));
    titleBar.position.set(0,.66,.033); tabletGroup.add(titleBar);
    // Three window buttons
    [0xFF5F57,0xFFBD2E,0x28C840].forEach((col,i)=>{
      const dot=new THREE.Mesh(new THREE.CircleGeometry(.028,16),new THREE.MeshBasicMaterial({color:col}));
      dot.position.set(-1.13+i*.075,.66,.034); tabletGroup.add(dot);
    });

    // Canvas area (art board)
    const artBoard=new THREE.Mesh(new THREE.PlaneGeometry(1.5,1.1),new THREE.MeshBasicMaterial({color:0xf5f0e8,transparent:true,opacity:.92}));
    artBoard.position.set(-.3,-.04,.034); tabletGroup.add(artBoard);

    // Paint strokes on artboard
    const strks=[
      {c:0xFF6B2B,x:-.35,y:.15,w:.55,h:.055,r:.12},
      {c:0xFF3CAC,x:-.1, y:.02,w:.42,h:.045,r:-.1 },
      {c:0x9B5DFF,x:-.4, y:-.12,w:.5,h:.042,r:.08 },
      {c:0x2AFADF,x:-.15,y:-.24,w:.38,h:.038,r:-.14},
      {c:0xBCFF47,x:-.38,y:-.35,w:.32,h:.034,r:.18 },
    ];
    strks.forEach(({c,x,y,w,h,r})=>{
      const st=new THREE.Mesh(new THREE.PlaneGeometry(w,h),new THREE.MeshBasicMaterial({color:c,transparent:true,opacity:.82}));
      st.position.set(x,y,.036); st.rotation.z=r; tabletGroup.add(st);
    });

    // Sketch lines
    for(let i=0;i<4;i++){
      const ln=new THREE.Mesh(new THREE.PlaneGeometry(.4-.05*i,.006),new THREE.MeshBasicMaterial({color:0x333322,transparent:true,opacity:.45}));
      ln.position.set(-.2-i*.02,.3-.1*i,.036); ln.rotation.z=(Math.random()-.5)*.15; tabletGroup.add(ln);
    }

    // Right panel (tools)
    const rPanel=new THREE.Mesh(new THREE.PlaneGeometry(.5,1.1),new THREE.MeshBasicMaterial({color:0x100e20}));
    rPanel.position.set(.96,-.04,.034); tabletGroup.add(rPanel);

    // Tool icons (simplified)
    const toolColors=[0xBCFF47,0xFF3CAC,0x2AFADF,0xFF6B2B,0x9B5DFF,0xffffff];
    toolColors.forEach((col,i)=>{
      const ic=new THREE.Mesh(new THREE.PlaneGeometry(.1,.065),new THREE.MeshBasicMaterial({color:col,transparent:true,opacity:.7}));
      ic.position.set(.96,.38-i*.13,.035); tabletGroup.add(ic);
    });

    // Color swatches bottom
    [0xFF6B2B,0xFF3CAC,0xBCFF47,0x2AFADF,0x9B5DFF,0xffffff,0x111111].forEach((col,i)=>{
      const sw=new THREE.Mesh(new THREE.PlaneGeometry(.1,.06),new THREE.MeshBasicMaterial({color:col}));
      sw.position.set(-.55+i*.14,-.62,.035); tabletGroup.add(sw);
    });

    // Cursor on screen (glowing dot + crosshair)
    const cursorGroup=new THREE.Group();
    cursorGroup.position.set(-.05,.08,.037); tabletGroup.add(cursorGroup);
    const curDot=new THREE.Mesh(new THREE.CircleGeometry(.022,16),new THREE.MeshBasicMaterial({color:0xffffff}));
    cursorGroup.add(curDot);
    const curGlow=new THREE.Mesh(new THREE.CircleGeometry(.055,16),new THREE.MeshBasicMaterial({color:0x9B5DFF,transparent:true,opacity:.35}));
    cursorGroup.add(curGlow);
    // Crosshair lines
    [[.1,.004],[.004,.1]].forEach(([w,h])=>{
      const cr=new THREE.Mesh(new THREE.PlaneGeometry(w,h),new THREE.MeshBasicMaterial({color:0xffffff,transparent:true,opacity:.5}));
      cursorGroup.add(cr);
    });

    // ── STYLUS PEN ──
    const penGroup=new THREE.Group();
    // Pen angled: tip points down-left toward screen
    penGroup.position.set(.6,.95,.55);
    penGroup.rotation.set(-.52,-.25,.38);
    root.add(penGroup);

    // Pen barrel
    penGroup.add(new THREE.Mesh(new THREE.CylinderGeometry(.048,.036,1.2,12),new THREE.MeshStandardMaterial({color:0x2a2a2a,metalness:.82,roughness:.25})));
    // Pen grip texture (darker section)
    const grip=new THREE.Mesh(new THREE.CylinderGeometry(.05,.046,.35,12),new THREE.MeshStandardMaterial({color:0x1a1a1a,metalness:.6,roughness:.55}));
    grip.position.y=-.32; penGroup.add(grip);
    // Grip ribs
    for(let i=0;i<8;i++){
      const rb=new THREE.Mesh(new THREE.TorusGeometry(.051,.005,6,16),new THREE.MeshStandardMaterial({color:0x333,metalness:.5,roughness:.7}));
      rb.position.y=-.18+i*.04; penGroup.add(rb);
    }
    // Side button
    const btn=new THREE.Mesh(new THREE.BoxGeometry(.02,.08,.06),new THREE.MeshStandardMaterial({color:0x9B5DFF,metalness:.4,roughness:.4}));
    btn.position.set(.05,.12,0); penGroup.add(btn);
    // Pen tip (tapered nib)
    const nib=new THREE.Mesh(new THREE.CylinderGeometry(.005,.048,.12,8),new THREE.MeshStandardMaterial({color:0xdddddd,metalness:1,roughness:.05}));
    nib.position.y=-.66; penGroup.add(nib);
    // Nib tip glow
    const nibGlow=new THREE.Mesh(new THREE.SphereGeometry(.018,10,10),new THREE.MeshBasicMaterial({color:0x9B5DFF,transparent:true,opacity:.7}));
    nibGlow.position.y=-.72; penGroup.add(nibGlow);
    // Top eraser end
    const eraser=new THREE.Mesh(new THREE.CylinderGeometry(.036,.036,.055,12),new THREE.MeshStandardMaterial({color:0x888,metalness:.8,roughness:.2}));
    eraser.position.y=.635; penGroup.add(eraser);

    // ── HAND (stylized, not cartoony) ──
    const handGroup=new THREE.Group();
    handGroup.position.set(.6,.78,.42);
    handGroup.rotation.set(-.45,-.2,.3);
    root.add(handGroup);

    const skinMat=new THREE.MeshStandardMaterial({color:0xd4a574,metalness:.02,roughness:.75});
    const skinDkMat=new THREE.MeshStandardMaterial({color:0xc49060,metalness:.02,roughness:.8});

    // Palm
    const palm=new THREE.Mesh(new THREE.BoxGeometry(.28,.22,.14),skinMat);
    handGroup.add(palm);
    // Palm rounding sides
    [-1,1].forEach(s=>{
      const ps=new THREE.Mesh(new THREE.CylinderGeometry(.07,.07,.22,12),skinMat);
      ps.rotation.z=Math.PI/2; ps.position.set(s*.17,0,0); handGroup.add(ps);
    });

    // Thumb
    const thumbPivot=new THREE.Group(); thumbPivot.position.set(-.18,-.06,0); handGroup.add(thumbPivot);
    const tb1=new THREE.Mesh(new THREE.CylinderGeometry(.04,.038,.16,10),skinMat);
    tb1.rotation.z=.5; tb1.position.set(-.06,-.05,0); thumbPivot.add(tb1);
    const tb2=new THREE.Mesh(new THREE.CylinderGeometry(.036,.032,.12,10),skinMat);
    tb2.rotation.z=.4; tb2.position.set(-.16,-.12,0); thumbPivot.add(tb2);

    // Index finger (holding pen)
    const idx=new THREE.Group(); idx.position.set(-.05,.12,.02); handGroup.add(idx);
    const i1=new THREE.Mesh(new THREE.CylinderGeometry(.038,.034,.2,10),skinMat);
    i1.rotation.x=.3; idx.add(i1);
    const i2=new THREE.Mesh(new THREE.CylinderGeometry(.033,.03,.16,10),skinMat);
    i2.rotation.x=.5; i2.position.set(0,.2,-.06); idx.add(i2);
    const i3=new THREE.Mesh(new THREE.CylinderGeometry(.03,.026,.12,10),skinMat);
    i3.rotation.x=.6; i3.position.set(0,.32,-.14); idx.add(i3);

    // Middle finger
    const mid=new THREE.Group(); mid.position.set(.04,.13,.01); handGroup.add(mid);
    const m1=new THREE.Mesh(new THREE.CylinderGeometry(.037,.033,.21,10),skinMat);
    m1.rotation.x=.25; mid.add(m1);
    const m2=new THREE.Mesh(new THREE.CylinderGeometry(.032,.029,.17,10),skinMat);
    m2.rotation.x=.45; m2.position.set(0,.21,-.05); mid.add(m2);

    // Ring + pinky (folded, just stumps)
    [[.12,.08],[.19,.05]].forEach(([x,len])=>{
      const fn=new THREE.Group(); fn.position.set(x,.05,0); handGroup.add(fn);
      const fb=new THREE.Mesh(new THREE.CylinderGeometry(.033,.03,len,10),skinMat);
      fb.rotation.x=.7; fn.add(fb);
      const fb2=new THREE.Mesh(new THREE.CylinderGeometry(.029,.026,len*.7,10),skinMat);
      fb2.rotation.x=.9; fb2.position.set(0,len*.6,-.04); fn.add(fb2);
    });

    // Knuckle details
    [-.06,.04,.12,.19].forEach(x=>{
      const kn=new THREE.Mesh(new THREE.SphereGeometry(.025,8,8),skinDkMat);
      kn.position.set(x,.13,.06); handGroup.add(kn);
    });

    // Center entire composition
    root.position.set(0,.1,0);
    camera.position.set(0,.1,5);
    camera.lookAt(0,.1,0);

    const clk=new THREE.Clock();
    (function loop(){
      requestAnimationFrame(loop); const t=clk.getElapsedTime();
      root.rotation.y=t*.42;
      root.rotation.x=Math.sin(t*.26)*.04;
      // Cursor pulse
      curGlow.material.opacity=.25+Math.abs(Math.sin(t*2))*.25;
      curDot.scale.setScalar(1+Math.sin(t*2)*.12);
      // Nib glow pulse
      nibGlow.material.opacity=.5+Math.sin(t*1.8)*.25;
      // Screen subtle color shift
      glow.material.opacity=.04+Math.abs(Math.sin(t*.8))*.06;
      accentL.position.set(Math.cos(t*.38)*4,3,Math.sin(t*.38)*4+4);
      accentL2.position.set(-3+Math.sin(t*.3),-1,3);
      renderer.render(scene,camera);
    })();
  })();

  // ════════════════════════════════════════════════════
  // HERO 3D
  // ════════════════════════════════════════════════════
  (function(){
    const canvas=document.getElementById('hero-canvas');
    const renderer=new THREE.WebGLRenderer({canvas,antialias:true,alpha:true});
    renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
    renderer.setClearColor(0x000000,0);
    const scene=new THREE.Scene();
    const camera=new THREE.PerspectiveCamera(60,1,.1,100);
    camera.position.set(0,0,5);
    function resize(){const w=canvas.parentElement.clientWidth,h=canvas.parentElement.clientHeight;renderer.setSize(w,h);camera.aspect=w/h;camera.updateProjectionMatrix();}
    resize();window.addEventListener('resize',resize);
    const mkP=(n,sp,col,sz,op)=>{
      const p=new Float32Array(n*3);
      for(let i=0;i<n;i++){p[i*3]=(Math.random()-.5)*sp;p[i*3+1]=(Math.random()-.5)*sp;p[i*3+2]=(Math.random()-.5)*(sp*.7);}
      const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(p,3));
      return new THREE.Points(g,new THREE.PointsMaterial({color:col,size:sz,transparent:true,opacity:op,sizeAttenuation:true}));
    };
    scene.add(mkP(1800,20,0xBCFF47,.03,.6));
    scene.add(mkP(600,18,0xFF3CAC,.025,.35));
    scene.add(mkP(400,16,0x2AFADF,.02,.25));
    const ag=(geo,col,op)=>{const m=new THREE.Mesh(geo,new THREE.MeshBasicMaterial({color:col,wireframe:true,transparent:true,opacity:op}));scene.add(m);return m;};
    const ico=ag(new THREE.IcosahedronGeometry(1.2,1),0xBCFF47,.08);ico.position.set(2.5,.5,0);
    const oct=ag(new THREE.OctahedronGeometry(.7,0),0xFF3CAC,.12);oct.position.set(-3,-.8,-1);
    const tet=ag(new THREE.TetrahedronGeometry(.5,0),0x2AFADF,.15);tet.position.set(-1.5,1.5,-2);
    const tor=ag(new THREE.TorusGeometry(.6,.08,8,24),0x9B5DFF,.1);tor.position.set(1,-1.8,-1.5);
    let mouseX=0,mouseY=0,tX=0,tY=0,scrollY=0;
    document.addEventListener('mousemove',e=>{mouseX=(e.clientX/window.innerWidth-.5)*2;mouseY=-(e.clientY/window.innerHeight-.5)*2;});
    window.addEventListener('scroll',()=>{scrollY=window.scrollY;});
    const clk=new THREE.Clock();
    (function loop(){
      requestAnimationFrame(loop);const t=clk.getElapsedTime();
      tX+=(mouseX-tX)*.05;tY+=(mouseY-tY)*.05;
      camera.position.x=tX*.4;camera.position.y=tY*.2;
      const sp=Math.min(scrollY/(canvas.parentElement.clientHeight||window.innerHeight),1);
      camera.position.z=5-sp*2.5;camera.rotation.z=sp*.1;
      scene.children[0].rotation.y=t*.04;scene.children[0].rotation.x=t*.02;
      scene.children[1].rotation.y=-t*.03;scene.children[2].rotation.x=t*.05;
      ico.rotation.x=t*.3+tY*.5;ico.rotation.y=t*.4+tX*.5;ico.position.y=.5+Math.sin(t*.7)*.3;
      oct.rotation.x=-t*.5;oct.rotation.z=t*.3;oct.position.y=-.8+Math.cos(t*.5)*.25;
      tet.rotation.y=t*.8;tet.rotation.x=t*.6;tet.position.x=-1.5+Math.sin(t*.4)*.2;
      tor.rotation.x=t*.4;tor.rotation.y=t*.6;tor.position.y=-1.8+Math.sin(t*.8)*.2;
      renderer.render(scene,camera);
    })();
  })();

  // CURSOR
  const cur=document.getElementById('cursor'),cf=document.getElementById('cf');
  let mx=0,my=0,fx=0,fy=0;
  document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cur.style.left=mx+'px';cur.style.top=my+'px';});
  (function a(){fx+=(mx-fx)*.12;fy+=(my-fy)*.12;cf.style.left=fx+'px';cf.style.top=fy+'px';requestAnimationFrame(a);})();
  document.querySelectorAll('a,button').forEach(el=>{
    el.addEventListener('mouseenter',()=>{cur.style.width='20px';cur.style.height='20px';cf.style.width='60px';cf.style.height='60px';});
    el.addEventListener('mouseleave',()=>{cur.style.width='12px';cur.style.height='12px';cf.style.width='36px';cf.style.height='36px';});
  });
  window.addEventListener('scroll',()=>document.getElementById('mainNav').classList.toggle('scrolled',window.scrollY>80));
  const obs=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting)x.target.classList.add('visible');}),{threshold:.08});
  document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));
  document.querySelectorAll('.hero .reveal').forEach(el=>setTimeout(()=>el.classList.add('visible'),100));
  const autoSec=document.querySelector('.auto-section');
  if(autoSec){
    const ao=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting){
      autoSec.classList.add('revealed');
      ['rw1','rw2','rw3','rw4'].forEach((id,i)=>setTimeout(()=>{const el=document.getElementById(id);if(el)el.style.opacity='1';},1200+i*200));
      ao.disconnect();
    }});},{threshold:.2});
    ao.observe(autoSec);
  }
  </script>
</body>
</html>

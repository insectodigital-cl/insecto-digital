      .section-title{font-size:clamp(1.8rem,7vw,2.8rem);margin-bottom:2.5rem}
      .manifesto-title{font-size:clamp(1.7rem,6vw,2.8rem)}
      .ai-title{font-size:clamp(1.8rem,7vw,3rem)}
      .auto-title{font-size:clamp(1.8rem,7vw,3rem)}
      .cta-title{font-size:clamp(2rem,9vw,3.5rem)}
      .services-grid{grid-template-columns:1fr}
      .service-card{border-right:none;border-bottom:1px solid var(--gris2)}
      .visual-grid{grid-template-columns:1fr}
      .ai-tools-grid{grid-template-columns:1fr}

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script>
  // ═══════════════════════════════════════════════════════
  // SHARED — transparent canvas over CSS gradient bg
  // Studio lighting rig for solid objects
  // ═══════════════════════════════════════════════════════
  function initCard(cid, wid) {
    const canvas = document.getElementById(cid);
    const wrap   = document.getElementById(wid);
    if (!canvas || !wrap) return null;
    const W = wrap.clientWidth || 560, H = wrap.clientHeight || 260;
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(W, H);
    renderer.setClearColor(0x000000, 0);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    const scene  = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(40, W / H, 0.1, 100);
    camera.position.set(0, 0.3, 5.5);
    camera.lookAt(0, 0, 0);
    new ResizeObserver(() => {
      const nw = wrap.clientWidth, nh = wrap.clientHeight;
      renderer.setSize(nw, nh);
      camera.aspect = nw / nh;
      camera.updateProjectionMatrix();
    }).observe(wrap);

    // Studio lighting — 3-point + environment
    const ambient = new THREE.AmbientLight(0xffffff, 0.4);
    scene.add(ambient);
    // Key light (top left)
    const key = new THREE.DirectionalLight(0xffffff, 2.2);
    key.position.set(-4, 6, 8); key.castShadow = true;
    key.shadow.mapSize.set(1024,1024);
    scene.add(key);
    // Fill light (right)
    const fill = new THREE.DirectionalLight(0xffffff, 0.8);
    fill.position.set(6, 2, 4); scene.add(fill);
    // Rim light (back)
    const rim = new THREE.DirectionalLight(0xffffff, 0.5);
    rim.position.set(0, -3, -5); scene.add(rim);

    return { renderer, scene, camera };
  }

  // ═══════════════════════════════════════════════════════
  // 1. DSLR CAMERA — Like reference photo 4
  //    Large solid black body + prominent lens with orange ring
  //    Grip, top plate, viewfinder, mode dial, shutter
  // ═══════════════════════════════════════════════════════
  (function buildDSLR() {
    const s = initCard('c-foto','w-foto');
    if (!s) return;
    const { renderer, scene, camera } = s;

    // Add warm orange accent light for photography card
    const accentL = new THREE.PointLight(0xFF7733, 1.2, 20);
    accentL.position.set(-3, 3, 4); scene.add(accentL);

    const root = new THREE.Group();
    scene.add(root);
    root.rotation.y = 0.35; // initial angle like reference

    // Materials — solid, realistic
    const bodyMat  = new THREE.MeshStandardMaterial({ color: 0x111111, metalness: 0.55, roughness: 0.45 });
    const rubberMat= new THREE.MeshStandardMaterial({ color: 0x0d0d0d, metalness: 0.1,  roughness: 0.95 });
    const silverMat= new THREE.MeshStandardMaterial({ color: 0x888888, metalness: 0.9,  roughness: 0.15 });
    const goldMat  = new THREE.MeshStandardMaterial({ color: 0xcc8800, metalness: 0.8,  roughness: 0.2  });
    const orangeMat= new THREE.MeshStandardMaterial({ color: 0xFF5500, metalness: 0.3,  roughness: 0.5  });
    const redMat   = new THREE.MeshStandardMaterial({ color: 0xcc2200, metalness: 0.2,  roughness: 0.6  });
    const glassMat = new THREE.MeshStandardMaterial({ color: 0x223344, metalness: 0.1,  roughness: 0.05, transparent: true, opacity: 0.85 });

    // ── BODY ──
    // Main body block
    const body = new THREE.Mesh(new THREE.BoxGeometry(2.1, 1.45, 0.92), bodyMat);
    body.castShadow = true; root.add(body);

    // Rubber texture panels (slightly raised)
    const frontPanel = new THREE.Mesh(new THREE.BoxGeometry(1.2, 1.3, 0.04), rubberMat);
    frontPanel.position.set(-0.2, -0.05, 0.47); root.add(frontPanel);

    // Grip (right side — rounded)
    const grip = new THREE.Mesh(new THREE.BoxGeometry(0.52, 1.38, 1.0), rubberMat);
    grip.position.set(1.1, -0.04, 0); root.add(grip);
    // Grip curve (cylinder on front edge)
    const gripCurve = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.5, 1.38, 24, 1, false, 0, Math.PI/2), rubberMat);
    gripCurve.rotation.y = Math.PI; gripCurve.position.set(0.88, -0.04, 0.5); root.add(gripCurve);

    // Top plate
    const topPlate = new THREE.Mesh(new THREE.BoxGeometry(2.1, 0.1, 0.92), bodyMat);
    topPlate.position.y = 0.775; root.add(topPlate);

    // Pentaprism hump (viewfinder)
    const vfBase = new THREE.Mesh(new THREE.BoxGeometry(0.68, 0.3, 0.58), bodyMat);
    vfBase.position.set(-0.2, 1.0, -0.1); root.add(vfBase);
    // VF slope (prism shape)
    const vfSlope = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.34, 0.68, 4, 1), bodyMat);
    vfSlope.rotation.y = Math.PI/4; vfSlope.position.set(-0.2, 0.98, -0.1); root.add(vfSlope);
    // VF glass
    const vfGlass = new THREE.Mesh(new THREE.PlaneGeometry(0.3, 0.2), glassMat);
    vfGlass.position.set(-0.2, 0.95, 0.34); root.add(vfGlass);

    // Mode dial (large, left top)
    const modeDial = new THREE.Mesh(new THREE.CylinderGeometry(0.25, 0.25, 0.08, 36), silverMat);
    modeDial.rotation.x = Math.PI/2; modeDial.position.set(-0.65, 0.84, 0); root.add(modeDial);
    // Dial markings
    for(let i=0;i<12;i++){
      const mk = new THREE.Mesh(new THREE.BoxGeometry(0.015, 0.25*2.1, 0.01), new THREE.MeshStandardMaterial({color:0x444}));
      const a=(i/12)*Math.PI*2;
      mk.position.set(-0.65+Math.cos(a)*0.24, 0.84+Math.sin(a)*0.24, 0); mk.rotation.z=a; root.add(mk);
    }
    // Center of dial
    root.add(new THREE.Mesh(new THREE.CylinderGeometry(0.06,0.06,0.09,16), bodyMat)).position.set(-0.65,0.84,0);

    // Shutter button (red, recessed)
    const shutterBase = new THREE.Mesh(new THREE.CylinderGeometry(0.11,0.11,0.05,20), silverMat);
    shutterBase.rotation.x=Math.PI/2; shutterBase.position.set(0.72,0.84,0); root.add(shutterBase);
    const shutterBtn = new THREE.Mesh(new THREE.CylinderGeometry(0.075,0.075,0.04,16), redMat);
    shutterBtn.rotation.x=Math.PI/2; shutterBtn.position.set(0.72,0.84,0.04); root.add(shutterBtn);

    // Hot shoe
    const shoe = new THREE.Mesh(new THREE.BoxGeometry(0.32,0.05,0.22), silverMat);
    shoe.position.set(-0.1,0.835,0); root.add(shoe);
    const shoeInner = new THREE.Mesh(new THREE.BoxGeometry(0.28,0.03,0.18), new THREE.MeshStandardMaterial({color:0x222,metalness:.5,roughness:.8}));
    shoeInner.position.set(-0.1,0.84,0); root.add(shoeInner);

    // Top LCD
    const lcd = new THREE.Mesh(new THREE.PlaneGeometry(0.38,0.22), new THREE.MeshBasicMaterial({color:0x223311}));
    lcd.position.set(0.25,0.845,0.02); root.add(lcd);

    // Body buttons (right side, small)
    [[0.85,0.3],[0.85,0.1],[0.85,-0.1]].forEach(([y,z])=>{
      const btn = new THREE.Mesh(new THREE.CylinderGeometry(0.04,0.04,0.05,10), bodyMat);
      btn.rotation.z=Math.PI/2; btn.position.set(1.37,y,z); root.add(btn);
    });

    // ── LENS MOUNT ──
    const mountRing = new THREE.Mesh(new THREE.TorusGeometry(0.5, 0.032, 12, 56), silverMat);
    mountRing.rotation.x=Math.PI/2; mountRing.position.set(0,0,0.47); root.add(mountRing);
    // Mount inner (dark)
    const mountInner = new THREE.Mesh(new THREE.CylinderGeometry(0.47,0.47,0.04,40), new THREE.MeshStandardMaterial({color:0x080808,metalness:.3,roughness:.8}));
    mountInner.rotation.x=Math.PI/2; mountInner.position.set(0,0,0.46); root.add(mountInner);

    // ── LENS ──
    const lg = new THREE.Group(); lg.position.set(0,0,0.48); root.add(lg);

    // Barrel 1 — widest
    const b1 = new THREE.Mesh(new THREE.CylinderGeometry(0.48,0.48,0.38,48), new THREE.MeshStandardMaterial({color:0x1a1a1a,metalness:.7,roughness:.3}));
    b1.rotation.x=Math.PI/2; b1.position.z=0.16; lg.add(b1);
    b1.castShadow=true;

    // Focus ring (rubber ribbed)
    const focusBand = new THREE.Mesh(new THREE.CylinderGeometry(0.492,0.492,0.22,48), rubberMat);
    focusBand.rotation.x=Math.PI/2; focusBand.position.z=0.16; lg.add(focusBand);
    for(let i=0;i<32;i++){
      const rb = new THREE.Mesh(new THREE.BoxGeometry(0.008,0.22,0.022), new THREE.MeshStandardMaterial({color:0x1a1a1a,metalness:.2,roughness:.9}));
      const a=(i/32)*Math.PI*2;
      rb.position.set(Math.cos(a)*0.492,Math.sin(a)*0.492,0.16); rb.rotation.z=a; lg.add(rb);
    }

    // ORANGE ring (like reference photo — between barrel 1 and 2)
    const orangeRing = new THREE.Mesh(new THREE.TorusGeometry(0.485,0.022,10,48), orangeMat);
    orangeRing.rotation.x=Math.PI/2; orangeRing.position.z=0.29; lg.add(orangeRing);

    // Barrel 2
    const b2 = new THREE.Mesh(new THREE.CylinderGeometry(0.41,0.41,0.28,48), new THREE.MeshStandardMaterial({color:0x222222,metalness:.75,roughness:.28}));
    b2.rotation.x=Math.PI/2; b2.position.z=0.44; lg.add(b2);
    b2.castShadow=true;

    // Aperture ring (silver)
    const apRing = new THREE.Mesh(new THREE.TorusGeometry(0.415,0.015,8,48), silverMat);
    apRing.rotation.x=Math.PI/2; apRing.position.z=0.57; lg.add(apRing);

    // Barrel 3 — front
    const b3 = new THREE.Mesh(new THREE.CylinderGeometry(0.36,0.36,0.2,48), new THREE.MeshStandardMaterial({color:0x1a1a1a,metalness:.7,roughness:.3}));
    b3.rotation.x=Math.PI/2; b3.position.z=0.67; lg.add(b3);

    // Front frame
    const frontFrame = new THREE.Mesh(new THREE.TorusGeometry(0.34,0.025,12,48), silverMat);
    frontFrame.rotation.x=Math.PI/2; frontFrame.position.z=0.775; lg.add(frontFrame);

    // Front glass (multiple layers for depth)
    const gl1 = new THREE.Mesh(new THREE.CircleGeometry(0.31,48), glassMat);
    gl1.position.z=0.78; lg.add(gl1);
    // Glass reflection
    const gl2 = new THREE.Mesh(new THREE.CircleGeometry(0.22,36), new THREE.MeshStandardMaterial({color:0x334455,metalness:.05,roughness:.02,transparent:true,opacity:.5}));
    gl2.position.z=0.782; lg.add(gl2);
    const gl3 = new THREE.Mesh(new THREE.CircleGeometry(0.1,24), new THREE.MeshStandardMaterial({color:0x4466aa,transparent:true,opacity:.35}));
    gl3.position.z=0.784; lg.add(gl3);
    // Highlight arc
    const glArc = new THREE.Mesh(new THREE.RingGeometry(0.22,0.3,48,1,0,Math.PI*0.55), new THREE.MeshBasicMaterial({color:0x99bbdd,transparent:true,opacity:.25,side:THREE.DoubleSide}));
    glArc.position.z=0.785; glArc.rotation.z=0.7; lg.add(glArc);

    // Aperture blades (8)
    const bladeGrp = new THREE.Group(); bladeGrp.position.z=0.77; lg.add(bladeGrp);
    const blades=[];
    for(let i=0;i<8;i++){
      const sh=new THREE.Shape();
      sh.moveTo(0,0);sh.lineTo(0.17,0.03);sh.lineTo(0.2,0.13);sh.lineTo(0.04,0.17);sh.closePath();
      const bm=new THREE.Mesh(new THREE.ShapeGeometry(sh),new THREE.MeshStandardMaterial({color:0x050505,metalness:.5,roughness:.6,side:THREE.DoubleSide}));
      const a=(i/8)*Math.PI*2; bm.rotation.z=a;
      bladeGrp.add(bm); blades.push({m:bm,a});
    }

    // ── REAR ──
    const screen = new THREE.Mesh(new THREE.PlaneGeometry(1.5,1.1), new THREE.MeshStandardMaterial({color:0x001122,metalness:.1,roughness:.5,transparent:true,opacity:.9}));
    screen.position.set(0,0,-0.47); screen.rotation.y=Math.PI; root.add(screen);
    // Screen border
    const scrBorder = new THREE.Mesh(new THREE.PlaneGeometry(1.54,1.14), new THREE.MeshStandardMaterial({color:0x111,metalness:.5,roughness:.6}));
    scrBorder.position.set(0,0,-0.468); scrBorder.rotation.y=Math.PI; root.add(scrBorder);

    const clk=new THREE.Clock();
    (function loop(){
      requestAnimationFrame(loop); const t=clk.getElapsedTime();
      root.rotation.y = 0.35 + Math.sin(t*0.4)*0.18;
      root.rotation.x = Math.sin(t*0.28)*0.06;
      blades.forEach(({m,a})=>{ m.rotation.z=a+Math.sin(t*0.9)*0.1+0.12; });
      focusBand.rotation.z = t*0.25;
      renderer.render(scene,camera);
    })();
  })();

  // ═══════════════════════════════════════════════════════
  // 2. RETRO CINEMA CAMERA — Like reference photo 3
  //    Classic film camera body with film reels on top,
  //    large matte box, follow focus, side handles
  // ═══════════════════════════════════════════════════════
  (function buildRetroCamera() {
    const s = initCard('c-video','w-video');
    if (!s) return;
    const { renderer, scene, camera } = s;

    const accentL = new THREE.PointLight(0xFF22AA, 0.8, 20);
    accentL.position.set(3, 4, 5); scene.add(accentL);

    const root = new THREE.Group();
    scene.add(root);
    root.rotation.y = -0.3;

    const bodyMat  = new THREE.MeshStandardMaterial({ color: 0x111111, metalness: 0.65, roughness: 0.5 });
    const darkMat  = new THREE.MeshStandardMaterial({ color: 0x0a0a0a, metalness: 0.5,  roughness: 0.6 });
    const silverMat= new THREE.MeshStandardMaterial({ color: 0x888888, metalness: 0.9,  roughness: 0.15 });
    const chromeMat= new THREE.MeshStandardMaterial({ color: 0xaaaaaa, metalness: 0.95, roughness: 0.08 });
    const woodMat  = new THREE.MeshStandardMaterial({ color: 0x5c3a1a, metalness: 0.05, roughness: 0.8  });
    const blackMat = new THREE.MeshStandardMaterial({ color: 0x080808, metalness: 0.3,  roughness: 0.7  });

    // ── MAIN BODY ──
    const body = new THREE.Mesh(new THREE.BoxGeometry(2.0, 1.3, 1.2), bodyMat);
    body.castShadow=true; root.add(body);

    // Body panels
    [-0.5,0.5].forEach(x=>{
      const panel = new THREE.Mesh(new THREE.BoxGeometry(0.5,1.32,0.04), darkMat);
      panel.position.set(x,0,0.62); root.add(panel);
    });

    // Top plate with recessed details
    const topPlate = new THREE.Mesh(new THREE.BoxGeometry(2.0,0.08,1.2), new THREE.MeshStandardMaterial({color:0x1a1a1a,metalness:.6,roughness:.45}));
    topPlate.position.y=0.69; root.add(topPlate);

    // Viewfinder box (left side)
    const vfBox = new THREE.Mesh(new THREE.BoxGeometry(0.35,0.28,0.55), bodyMat);
    vfBox.position.set(-0.55,0.5,-0.4); root.add(vfBox);
    const vfGlass = new THREE.Mesh(new THREE.PlaneGeometry(0.2,0.18), new THREE.MeshStandardMaterial({color:0x001133,transparent:true,opacity:.85}));
    vfGlass.position.set(-0.72,0.5,-0.4); vfGlass.rotation.y=Math.PI/2; root.add(vfGlass);

    // Film magazine (top — large box, distinctive retro look)
    const mag = new THREE.Mesh(new THREE.BoxGeometry(1.1, 0.65, 0.85), new THREE.MeshStandardMaterial({color:0x0d0d0d,metalness:.55,roughness:.5}));
    mag.position.set(0.2, 1.03, -0.1); root.add(mag);
    const magEdge = new THREE.Mesh(new THREE.BoxGeometry(1.12,0.67,0.87), new THREE.MeshBasicMaterial({color:0x333,wireframe:true,transparent:true,opacity:.15}));
    magEdge.position.set(0.2,1.03,-0.1); root.add(magEdge);

    // Magazine latch
    const latch = new THREE.Mesh(new THREE.BoxGeometry(0.08,0.1,0.05), chromeMat);
    latch.position.set(-0.35,0.78,-0.5); root.add(latch);

    // FILM REELS on top (iconic retro element)
    [-0.35, 0.35].forEach((x,i) => {
      const reelGroup = new THREE.Group();
      reelGroup.position.set(x, 1.42, -0.1); root.add(reelGroup);

      // Reel disc
      const disc = new THREE.Mesh(new THREE.CylinderGeometry(0.22,0.22,0.08,36), new THREE.MeshStandardMaterial({color:0x1a1a1a,metalness:.6,roughness:.4}));
      disc.rotation.x=Math.PI/2; reelGroup.add(disc);

      // Reel hub
      const hub = new THREE.Mesh(new THREE.CylinderGeometry(0.07,0.07,0.1,12), chromeMat);
      hub.rotation.x=Math.PI/2; reelGroup.add(hub);

      // Spokes
      for(let j=0;j<6;j++){
        const spoke = new THREE.Mesh(new THREE.BoxGeometry(0.025,0.32,0.06), new THREE.MeshStandardMaterial({color:0x333,metalness:.5,roughness:.5}));
        spoke.rotation.z=(j/6)*Math.PI*2;
        spoke.position.set(Math.cos((j/6)*Math.PI*2)*0.14, Math.sin((j/6)*Math.PI*2)*0.14, 0);
        reelGroup.add(spoke);
      }

      // Reel outer ring
      const outerRing = new THREE.Mesh(new THREE.TorusGeometry(0.21,0.014,8,36), chromeMat);
      outerRing.rotation.x=Math.PI/2; reelGroup.add(outerRing);
    });

    // ── LENS ──
    const lg = new THREE.Group(); lg.position.set(0,0,0.61); root.add(lg);

    // Lens support bracket
    const bracket = new THREE.Mesh(new THREE.BoxGeometry(0.6,0.1,0.2), new THREE.MeshStandardMaterial({color:0x1a1a1a,metalness:.7,roughness:.4}));
    bracket.position.set(0,-0.62,0.1); lg.add(bracket);

    // Main lens barrel (large, boxy retro style)
    const lensBody = new THREE.Mesh(new THREE.CylinderGeometry(0.38,0.38,0.7,36), new THREE.MeshStandardMaterial({color:0x1a1a1a,metalness:.7,roughness:.35}));
    lensBody.rotation.x=Math.PI/2; lensBody.position.z=0.3; lg.add(lensBody);
    lensBody.castShadow=true;

    // Focus ring (large markings)
    const focusRing = new THREE.Mesh(new THREE.CylinderGeometry(0.395,0.395,0.28,36), new THREE.MeshStandardMaterial({color:0x222222,metalness:.65,roughness:.4}));
    focusRing.rotation.x=Math.PI/2; focusRing.position.z=0.3; lg.add(focusRing);
    for(let i=0;i<20;i++){
      const rb=new THREE.Mesh(new THREE.BoxGeometry(0.01,0.28,0.025),new THREE.MeshStandardMaterial({color:0x333,metalness:.4,roughness:.7}));
      const a=(i/20)*Math.PI*2;
      rb.position.set(Math.cos(a)*0.405,Math.sin(a)*0.405,0.3); rb.rotation.z=a; lg.add(rb);
    }

    // Iris ring
    const iris = new THREE.Mesh(new THREE.TorusGeometry(0.39,0.018,8,36), chromeMat);
    iris.rotation.x=Math.PI/2; iris.position.z=0.46; lg.add(iris);

    // Front element
    const frontB = new THREE.Mesh(new THREE.CylinderGeometry(0.32,0.32,0.18,36), new THREE.MeshStandardMaterial({color:0x111,metalness:.7,roughness:.3}));
    frontB.rotation.x=Math.PI/2; frontB.position.z=0.64; lg.add(frontB);

    // Front frame
    const fFrame = new THREE.Mesh(new THREE.TorusGeometry(0.3,0.025,10,40), chromeMat);
    fFrame.rotation.x=Math.PI/2; fFrame.position.z=0.735; lg.add(fFrame);

    // Glass
    const lgl = new THREE.Mesh(new THREE.CircleGeometry(0.276,40), new THREE.MeshStandardMaterial({color:0x0a1420,metalness:.05,roughness:.02,transparent:true,opacity:.82}));
    lgl.position.z=0.74; lg.add(lgl);
    const glRef = new THREE.Mesh(new THREE.CircleGeometry(0.1,24), new THREE.MeshBasicMaterial({color:0x2244aa,transparent:true,opacity:.3}));
    glRef.position.z=0.742; lg.add(glRef);

    // MATTE BOX (front of lens — very distinctive retro element)
    const mb = new THREE.Group(); mb.position.set(0,0,0.82); lg.add(mb);
    const mbBody = new THREE.Mesh(new THREE.BoxGeometry(0.88,0.66,0.3), blackMat);
    mb.add(mbBody);
    // Matte box flaps
    const flap1 = new THREE.Mesh(new THREE.BoxGeometry(0.9,0.06,0.25), blackMat);
    flap1.position.y=0.34; mb.add(flap1);
    const flap2 = new THREE.Mesh(new THREE.BoxGeometry(0.06,0.66,0.25), blackMat);
    flap2.position.x=0.46; mb.add(flap2);
    const flap3 = new THREE.Mesh(new THREE.BoxGeometry(0.06,0.66,0.25), blackMat);
    flap3.position.x=-0.46; mb.add(flap3);
    // Matte box opening
    const mbOpen = new THREE.Mesh(new THREE.PlaneGeometry(0.6,0.46), new THREE.MeshBasicMaterial({color:0x000000,side:THREE.DoubleSide}));
    mbOpen.position.z=0.155; mb.add(mbOpen);

    // FOLLOW FOCUS (right side of lens)
    const ff = new THREE.Group(); ff.position.set(0.52,-0.36,0.3); root.add(ff);
    ff.add(new THREE.Mesh(new THREE.BoxGeometry(0.2,0.28,0.16), new THREE.MeshStandardMaterial({color:0x1a1a1a,metalness:.6,roughness:.4})));
    const ffKnob = new THREE.Mesh(new THREE.CylinderGeometry(0.1,0.1,0.06,16), chromeMat);
    ffKnob.rotation.x=Math.PI/2; ffKnob.position.z=0.1; ff.add(ffKnob);
    for(let i=0;i<8;i++){
      const rk=new THREE.Mesh(new THREE.BoxGeometry(0.008,0.06,0.018),new THREE.MeshStandardMaterial({color:0x444,metalness:.5,roughness:.6}));
      const a=(i/8)*Math.PI*2; rk.position.set(Math.cos(a)*0.1,Math.sin(a)*0.1,0.1); rk.rotation.z=a; ff.add(rk);
    }

    // SIDE HANDLE (wooden)
    const handle = new THREE.Group(); handle.position.set(1.08,0,0); root.add(handle);
    handle.add(new THREE.Mesh(new THREE.BoxGeometry(0.16,0.9,0.18), woodMat));
    const hkTop = new THREE.Mesh(new THREE.BoxGeometry(0.35,0.12,0.16), woodMat);
    hkTop.position.set(-0.1,0.48,0); handle.add(hkTop);

    // Various knobs and buttons on body
    [[0.9,0.3,0.62],[0.9,0.0,0.62],[0.9,-0.3,0.62]].forEach(([x,y,z])=>{
      const kn=new THREE.Mesh(new THREE.CylinderGeometry(0.055,0.055,0.06,14),chromeMat);
      kn.rotation.z=Math.PI/2; kn.position.set(x,y,z); root.add(kn);
    });

    camera.position.set(0.2, 0.5, 6.0);
    camera.lookAt(0, 0.2, 0);

    const clk=new THREE.Clock();
    (function loop(){
      requestAnimationFrame(loop); const t=clk.getElapsedTime();
      root.rotation.y = -0.3 + Math.sin(t*0.38)*0.2;
      root.rotation.x = Math.sin(t*0.26)*0.05;
      // Reels spin
      root.children.forEach(c => {
        if(c.children && c.children.length > 3) c.rotation.z = t*0.6;
      });
      iris.rotation.z = -t*0.3;
      renderer.render(scene,camera);
    })();
  })();

  // ═══════════════════════════════════════════════════════
  // 3. OVER-EAR HEADPHONES — Like reference photo 2
  //    Large solid cups, thick padded band, stand base
  //    Chunky, premium studio monitor style
  // ═══════════════════════════════════════════════════════
  (function buildHeadphones() {
    const s = initCard('c-audio','w-audio');
    if (!s) return;
    const { renderer, scene, camera } = s;

    const accentL = new THREE.PointLight(0x00FFEE, 1.0, 18);
    accentL.position.set(-3, 4, 5); scene.add(accentL);

    const root = new THREE.Group();
    scene.add(root);

    // Materials matching reference — yellow/gold body, teal/dark cushions
    const shellMat  = new THREE.MeshStandardMaterial({ color: 0x1a1a1a,  metalness: 0.55, roughness: 0.4 });
    const cushMat   = new THREE.MeshStandardMaterial({ color: 0x111111,  metalness: 0.05, roughness: 0.98 });
    const silverMat = new THREE.MeshStandardMaterial({ color: 0x999999,  metalness: 0.88, roughness: 0.15 });
    const cyanShell = new THREE.MeshStandardMaterial({ color: 0x2AFADF,  metalness: 0.35, roughness: 0.45 });
    const darkMat   = new THREE.MeshStandardMaterial({ color: 0x0d0d0d,  metalness: 0.4,  roughness: 0.6 });

    // ── HEADBAND ──
    // Main band — solid arc using TubeGeometry
    const bandCurve = new THREE.QuadraticBezierCurve3(
      new THREE.Vector3(-1.0, 0, 0),
      new THREE.Vector3(0, 1.3, 0),
      new THREE.Vector3(1.0, 0, 0)
    );
    const bandTube = new THREE.TubeGeometry(bandCurve, 32, 0.075, 14, false);
    const band = new THREE.Mesh(bandTube, shellMat);
    band.castShadow=true; root.add(band);

    // Band padding underside (softer)
    const padCurve = new THREE.QuadraticBezierCurve3(
      new THREE.Vector3(-0.96, 0.04, 0),
      new THREE.Vector3(0, 1.24, 0),
      new THREE.Vector3(0.96, 0.04, 0)
    );
    const padTube = new THREE.TubeGeometry(padCurve, 28, 0.058, 10, false);
    root.add(new THREE.Mesh(padTube, cushMat));

    // Band top accent strip (cyan)
    const accentCurve = new THREE.QuadraticBezierCurve3(
      new THREE.Vector3(-0.92, 0.08, 0.02),
      new THREE.Vector3(0, 1.22, 0.02),
      new THREE.Vector3(0.92, 0.08, 0.02)
    );
    const accentTube = new THREE.TubeGeometry(accentCurve, 28, 0.018, 8, false);
    root.add(new THREE.Mesh(accentTube, cyanShell));

    // ── ADJUSTMENT SLIDERS ──
    [-1, 1].forEach(side => {
      // Slider housing
      const sliderHousing = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.48, 0.13), shellMat);
      sliderHousing.position.set(side*1.0, -0.55, 0); root.add(sliderHousing);

      // Adjustment marks
      for(let i=0;i<5;i++){
        const mk=new THREE.Mesh(new THREE.BoxGeometry(0.025,0.008,0.13), new THREE.MeshBasicMaterial({color:0x444}));
        mk.position.set(side*(1.04+0.012),-0.75+i*0.08,0); root.add(mk);
      }

      // Yoke joint (solid cylinder)
      const yoke = new THREE.Mesh(new THREE.CylinderGeometry(0.11,0.11,0.14,20), silverMat);
      yoke.rotation.z=Math.PI/2; yoke.position.set(side*1.0,-0.88,0); root.add(yoke);

      // ── EAR CUP ── (the main visual element — large and solid)
      const cupGrp = new THREE.Group();
      cupGrp.position.set(side*1.1, -1.05, 0); root.add(cupGrp);

      // Outer shell — large half-sphere style
      const outerCup = new THREE.Mesh(
        new THREE.CylinderGeometry(0.45, 0.42, 0.28, 36),
        shellMat
      );
      outerCup.rotation.z=Math.PI/2; outerCup.castShadow=true; cupGrp.add(outerCup);

      // Cup dome (rounded outer face)
      const cupDome = new THREE.Mesh(
        new THREE.SphereGeometry(0.44, 28, 20, 0, Math.PI*2, 0, Math.PI*0.55),
        shellMat
      );
      cupDome.rotation.y = side>0 ? Math.PI/2 : -Math.PI/2;
      cupDome.position.x = side*0.01; cupGrp.add(cupDome);

      // Logo plate on dome
      const logoPlate = new THREE.Mesh(new THREE.BoxGeometry(0.1,0.1,0.03), silverMat);
      logoPlate.position.set(side*0.44, 0.1, 0); cupGrp.add(logoPlate);

      // Cyan accent ring (outer rim)
      const accentRing = new THREE.Mesh(new THREE.TorusGeometry(0.43,0.016,10,40), cyanShell);
      accentRing.rotation.y=Math.PI/2; cupGrp.add(accentRing);

      // Ear cushion (thick torus — key element from reference)
      const cushion = new THREE.Mesh(
        new THREE.TorusGeometry(0.32, 0.1, 14, 40),
        new THREE.MeshStandardMaterial({color:0x0e1810,metalness:.05,roughness:.97})
      );
      cushion.rotation.y=Math.PI/2;
      cushion.position.x = -side*0.06;
      cupGrp.add(cushion);

      // Driver plate (inside)
      const driver = new THREE.Mesh(new THREE.CircleGeometry(0.28,32), new THREE.MeshStandardMaterial({color:0x222,metalness:.4,roughness:.7}));
      driver.rotation.y = side>0?-Math.PI/2:Math.PI/2;
      driver.position.x = side*0.02; cupGrp.add(driver);

      // Driver dome center
      const drvDome = new THREE.Mesh(
        new THREE.SphereGeometry(0.12, 16, 12, 0, Math.PI*2, 0, Math.PI*0.5),
        new THREE.MeshStandardMaterial({color:0x1a1a1a,metalness:.3,roughness:.8})
      );
      drvDome.rotation.y = side>0?-Math.PI/2:Math.PI/2;
      drvDome.position.x = side*0.03; cupGrp.add(drvDome);

      // Driver surround ring
      const drvSurround = new THREE.Mesh(new THREE.TorusGeometry(0.2,0.04,8,32), new THREE.MeshStandardMaterial({color:0x333,metalness:.2,roughness:.9}));
      drvSurround.rotation.y=Math.PI/2; drvSurround.position.x=side*0.025; cupGrp.add(drvSurround);


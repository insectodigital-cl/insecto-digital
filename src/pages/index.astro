  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script>
  // ─────────────────────────────────────────────────────
  // UTILITY: create mini scene in a card canvas
  // ─────────────────────────────────────────────────────
  function mkCard(canvasId, bgHex) {
    const canvas = document.getElementById(canvasId);
    if (!canvas) return null;
    const wrap = document.getElementById(canvasId.replace('c-', 'w-'));
    const W = wrap.clientWidth || 560, H = wrap.clientHeight || 220;
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: bgHex === undefined });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(W, H);
    if (bgHex !== undefined) renderer.setClearColor(bgHex, 1);
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(48, W / H, 0.1, 100);
    camera.position.z = 4.2;
    new ResizeObserver(() => {
      const nw = wrap.clientWidth, nh = wrap.clientHeight;
      renderer.setSize(nw, nh);
      camera.aspect = nw / nh;
      camera.updateProjectionMatrix();
    }).observe(wrap);
    // Lights
    scene.add(new THREE.AmbientLight(0xffffff, 0.5));

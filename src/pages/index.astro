---
// index.astro - Insecto Digital — v12
// Glowing wireframe + solid emissive objects on colored gradient card backgrounds
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Insecto Digital — Hub Creativo</title>
  <meta name="description" content="Hub creativo digital. Diseño, fotografía, video, audio, AI y automatización. Santiago, Chile." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Sans:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet" />
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --negro:#080808;--verde:#BCFF47;--magenta:#FF3CAC;
      --cyan:#2AFADF;--naranja:#FF6B2B;--violeta:#9B5DFF;
      --blanco:#F5F0E8;--gris:#1A1A1A;--gris2:#2C2C2C;
      --wa:#25D366;--wa2:#1da851;
      --fd:'Syne',sans-serif;--fb:'DM Sans',sans-serif;
    }
    html{scroll-behavior:smooth}
    body{background:var(--negro);color:var(--blanco);font-family:var(--fb);font-weight:300;overflow-x:hidden;cursor:none}
    .cursor{width:12px;height:12px;background:var(--verde);border-radius:50%;position:fixed;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:width .2s,height .2s;mix-blend-mode:difference}
    .cursor-follower{width:36px;height:36px;border:1px solid rgba(188,255,71,.4);border-radius:50%;position:fixed;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:all .12s ease-out}
    nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;justify-content:space-between;align-items:center;padding:1.5rem 4rem;transition:background .4s}
    nav.scrolled{background:rgba(8,8,8,.9);backdrop-filter:blur(14px)}
    .logo{font-family:var(--fd);font-weight:800;font-size:1.1rem;color:var(--blanco);text-decoration:none;letter-spacing:-.02em}
    .logo span{color:var(--verde)}
    nav ul{list-style:none;display:flex;gap:2.5rem;align-items:center}
    nav ul a{color:var(--blanco);text-decoration:none;font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;opacity:.7;transition:opacity .2s}
    nav ul a:hover{opacity:1}
    .nav-cta{font-family:var(--fd);font-weight:700;font-size:.75rem;color:#fff!important;background:var(--wa);padding:.5rem 1.25rem;border-radius:100px;opacity:1!important;display:inline-flex;align-items:center;gap:.4rem;text-transform:none!important;transition:background .2s!important}
    .nav-cta:hover{background:var(--wa2)!important}
    .hero{min-height:100vh;display:flex;flex-direction:column;justify-content:flex-end;padding:0 4rem 5rem;position:relative;overflow:hidden}
    #hero-canvas{position:absolute;inset:0;z-index:0;width:100%;height:100%}
    .hero-vignette{position:absolute;inset:0;z-index:1;background:radial-gradient(ellipse at 50% 0%,rgba(8,8,8,0) 0%,rgba(8,8,8,.6) 70%),linear-gradient(to top,rgba(8,8,8,.95) 0%,rgba(8,8,8,.3) 50%,rgba(8,8,8,0) 100%);pointer-events:none}
    .hero-content{position:relative;z-index:2}
    .hero-label{font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--verde);margin-bottom:1.5rem;display:flex;align-items:center;gap:.75rem}
    .hero-label::before{content:'';display:block;width:32px;height:1px;background:var(--verde)}
    .hero-title{font-family:var(--fd);font-weight:800;font-size:clamp(3.2rem,10vw,9rem);line-height:.92;letter-spacing:-.04em;overflow-wrap:break-word}
    .hero-title .la{color:var(--verde)}
    .hero-title .ls{-webkit-text-stroke:1px var(--blanco);color:transparent}
    .hero-bottom{display:flex;justify-content:space-between;align-items:flex-end;margin-top:4rem}
    .hero-desc{max-width:340px;font-size:1rem;line-height:1.6;opacity:.65}
    .hero-actions{display:flex;gap:1rem;align-items:center}
    .hero-scroll{position:absolute;right:4rem;bottom:5rem;z-index:2;writing-mode:vertical-rl;font-size:.65rem;letter-spacing:.2em;text-transform:uppercase;opacity:.35;display:flex;align-items:center;gap:.75rem}
    .hero-scroll::after{content:'';width:1px;height:60px;background:var(--blanco);opacity:.3;animation:sl 2s ease-in-out infinite}
    @keyframes sl{0%,100%{transform:scaleY(1);opacity:.3}50%{transform:scaleY(.5);opacity:.1}}
    .btn-p{font-family:var(--fd);font-weight:700;font-size:.85rem;background:var(--verde);color:var(--negro);padding:1rem 2rem;border-radius:100px;text-decoration:none;letter-spacing:.05em;text-transform:uppercase;transition:transform .2s,box-shadow .2s;border:none;cursor:pointer;display:inline-block}
    .btn-p:hover{transform:translateY(-2px);box-shadow:0 8px 40px rgba(188,255,71,.35)}
    .btn-g{font-size:.8rem;color:var(--blanco);text-decoration:none;letter-spacing:.08em;text-transform:uppercase;opacity:.6;display:flex;align-items:center;gap:.5rem;transition:opacity .2s}
    .btn-g:hover{opacity:1}
    .btn-g svg{transition:transform .2s}
    .btn-g:hover svg{transform:translateX(4px)}
    .btn-wa{display:inline-flex;align-items:center;gap:.6rem;font-family:var(--fd);font-weight:700;font-size:.85rem;background:var(--wa);color:#fff;padding:1rem 2rem;border-radius:100px;text-decoration:none;transition:transform .2s,box-shadow .2s}
    .btn-wa:hover{transform:translateY(-2px);box-shadow:0 8px 40px rgba(37,211,102,.4);background:var(--wa2)}
    .btn-wa-lg{display:inline-flex;align-items:center;gap:.85rem;font-family:var(--fd);font-weight:700;font-size:1.15rem;background:var(--wa);color:#fff;padding:1.3rem 3.2rem;border-radius:100px;text-decoration:none;transition:transform .25s,box-shadow .25s,background .2s;position:relative;z-index:1}
    .btn-wa-lg:hover{transform:translateY(-4px) scale(1.02);box-shadow:0 20px 60px rgba(37,211,102,.5);background:var(--wa2)}
    .btn-wa-lg::before{content:'';position:absolute;inset:-4px;border-radius:100px;border:2px solid rgba(37,211,102,.4);animation:btnPulse 2.5s ease-in-out infinite}
    @keyframes btnPulse{0%,100%{transform:scale(1);opacity:.4}50%{transform:scale(1.04);opacity:.1}}
    .wa-float{position:fixed;bottom:2rem;right:2rem;z-index:500;width:60px;height:60px;border-radius:50%;background:var(--wa);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(37,211,102,.5);text-decoration:none;animation:fb 3s ease-in-out infinite}
    .wa-float:hover{transform:scale(1.1)!important;animation:none}
    @keyframes fb{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
    .ticker{border-top:1px solid var(--gris2);border-bottom:1px solid var(--gris2);padding:1rem 0;overflow:hidden;white-space:nowrap}
    .ticker-inner{display:inline-flex;animation:tk 30s linear infinite}
    .ti{display:inline-flex;align-items:center;gap:1.5rem;padding:0 2rem;font-family:var(--fd);font-weight:700;font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;opacity:.4}
    .td{width:5px;height:5px;border-radius:50%;background:var(--verde);flex-shrink:0}
    .td.mg{background:var(--magenta)}.td.cy{background:var(--cyan)}.td.na{background:var(--naranja)}.td.vi{background:var(--violeta)}
    @keyframes tk{from{transform:translateX(0)}to{transform:translateX(-50%)}}
    .sec{padding:8rem 4rem}
    .sl{font-size:.65rem;letter-spacing:.25em;text-transform:uppercase;color:var(--verde);margin-bottom:3rem;display:flex;align-items:center;gap:.75rem}
    .sl::before{content:'';width:24px;height:1px;background:var(--verde)}
    .st{font-family:var(--fd);font-weight:800;font-size:clamp(2rem,5vw,4.5rem);line-height:1.05;letter-spacing:-.03em;margin-bottom:5rem;max-width:700px}
    .sg{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;border:1px solid var(--gris2)}
    .sc{padding:3rem 2.5rem;border-right:1px solid var(--gris2);position:relative;overflow:hidden;transition:background .3s}
    .sc:last-child{border-right:none}
    .sc::before{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:var(--verde);transform:scaleX(0);transform-origin:left;transition:transform .4s ease}
    .sc:hover::before{transform:scaleX(1)}
    .sc:hover{background:var(--gris)}
    .sn{font-family:var(--fd);font-size:.65rem;letter-spacing:.15em;color:var(--verde);margin-bottom:2rem;opacity:.8}
    .si{font-size:2.5rem;margin-bottom:1.5rem;display:block}
    .snm{font-family:var(--fd);font-weight:700;font-size:1.25rem;margin-bottom:1rem;letter-spacing:-.02em}
    .sd{font-size:.9rem;line-height:1.65;opacity:.55}
    .stags{margin-top:2rem;display:flex;flex-wrap:wrap;gap:.4rem}
    .tag{font-size:.65rem;letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--gris2);padding:.3rem .7rem;border-radius:100px;opacity:.5;transition:border-color .2s,opacity .2s}
    .sc:hover .tag{border-color:var(--verde);opacity:.8}
    .manifesto{padding:8rem 4rem;background:var(--verde);color:var(--negro);position:relative;overflow:hidden}
    .mbg{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:var(--fd);font-weight:800;font-size:25vw;color:rgba(0,0,0,.06);white-space:nowrap;pointer-events:none;user-select:none}
    .mc{position:relative;z-index:1;max-width:1000px}
    .ml{font-size:.65rem;letter-spacing:.25em;text-transform:uppercase;margin-bottom:2rem;opacity:.6;display:flex;align-items:center;gap:.75rem}
    .ml::before{content:'';width:24px;height:1px;background:var(--negro)}
    .mt{font-family:var(--fd);font-weight:800;font-size:clamp(2rem,5vw,5rem);line-height:1.05;letter-spacing:-.03em}
    .mt em{font-style:italic;font-weight:400}

    /* ══════════════════════════════════════
       VISUAL CARDS — colored gradient backgrounds
    ══════════════════════════════════════ */
    .visual-section{padding:8rem 4rem;background:var(--gris)}
    .vg{display:grid;grid-template-columns:1fr 1fr;gap:2rem}
    .vc{border-radius:10px;overflow:hidden;transition:transform .4s cubic-bezier(.25,.46,.45,.94),box-shadow .4s;border:1px solid rgba(255,255,255,.06)}
    .vc:hover{transform:translateY(-8px);box-shadow:0 32px 80px rgba(0,0,0,.7)}

    /* Card canvas header with colored bg */
    .cc{height:240px;position:relative;overflow:hidden}
    .cc canvas{width:100%!important;height:100%!important;display:block}
    /* Bottom fade into card body */
    .cc::after{content:'';position:absolute;bottom:0;left:0;right:0;height:70px;pointer-events:none;z-index:1}

    /* Individual card gradient backgrounds */
    .cc-foto{background:radial-gradient(ellipse at 50% 40%,rgba(255,107,43,.22) 0%,rgba(255,107,43,.06) 50%,#0d0805 100%)}
    .cc-foto::after{background:linear-gradient(to top,#0d0805,transparent)}
    .vb-foto{background:#0d0805}

    .cc-video{background:radial-gradient(ellipse at 50% 40%,rgba(255,60,172,.22) 0%,rgba(255,60,172,.06) 50%,#0a060d 100%)}
    .cc-video::after{background:linear-gradient(to top,#0a060d,transparent)}
    .vb-video{background:#0a060d}

    .cc-audio{background:radial-gradient(ellipse at 50% 40%,rgba(42,250,223,.2) 0%,rgba(42,250,223,.05) 50%,#050d0c 100%)}
    .cc-audio::after{background:linear-gradient(to top,#050d0c,transparent)}
    .vb-audio{background:#050d0c}

    .cc-arte{background:radial-gradient(ellipse at 50% 40%,rgba(155,93,255,.22) 0%,rgba(155,93,255,.06) 50%,#080610 100%)}
    .cc-arte::after{background:linear-gradient(to top,#080610,transparent)}
    .vb-arte{background:#080610}

    .vb{padding:1.75rem 2.5rem 2.5rem}
    .vn{font-family:var(--fd);font-size:.65rem;letter-spacing:.15em;margin-bottom:.6rem;opacity:.9}
    .vn-na{color:var(--naranja)}.vn-mg{color:var(--magenta)}.vn-cy{color:var(--cyan)}.vn-vi{color:var(--violeta)}
    .vnm{font-family:var(--fd);font-weight:700;font-size:1.3rem;margin-bottom:.7rem;letter-spacing:-.02em}
    .vd{font-size:.9rem;line-height:1.6;opacity:.55}
    .vt{margin-top:1.5rem;display:flex;flex-wrap:wrap;gap:.4rem}

    .ai-section{padding:8rem 4rem;position:relative;overflow:hidden}
    .ai-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 20% 50%,rgba(155,93,255,.1) 0%,transparent 60%),radial-gradient(ellipse at 80% 20%,rgba(42,250,223,.07) 0%,transparent 50%),radial-gradient(ellipse at 60% 80%,rgba(255,60,172,.07) 0%,transparent 50%);pointer-events:none}
    .ai-inner{position:relative;z-index:1}
    .ai-badge{display:inline-flex;align-items:center;gap:.5rem;background:rgba(155,93,255,.12);border:1px solid rgba(155,93,255,.25);padding:.4rem 1rem;border-radius:100px;font-size:.7rem;letter-spacing:.15em;text-transform:uppercase;color:var(--violeta);margin-bottom:2rem}
    .ai-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--violeta);animation:pulse 2s ease-in-out infinite}
    @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.7)}}
    .ai-title{font-family:var(--fd);font-weight:800;font-size:clamp(2rem,6vw,5.5rem);line-height:1;letter-spacing:-.04em;margin-bottom:1.5rem}
    .ai-title .grad{background:linear-gradient(90deg,var(--violeta),var(--cyan),var(--magenta));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .ai-sub{font-size:1.05rem;opacity:.6;line-height:1.6;max-width:520px;margin-bottom:4rem}
    .atg{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
    .at{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:16px;padding:2rem;transition:all .3s;position:relative;overflow:hidden}
    .at::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(155,93,255,.07),transparent);opacity:0;transition:opacity .3s}
    .at:hover::before{opacity:1}
    .at:hover{border-color:rgba(155,93,255,.3);transform:translateY(-4px)}
    .ati{font-size:2rem;margin-bottom:1rem;display:block}
    .atn{font-family:var(--fd);font-weight:700;font-size:1.1rem;margin-bottom:.6rem;letter-spacing:-.02em}
    .atd{font-size:.85rem;opacity:.5;line-height:1.55}
    .ate{margin-top:1rem;display:flex;flex-wrap:wrap;gap:.35rem}
    .atex{font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;background:rgba(155,93,255,.1);border:1px solid rgba(155,93,255,.2);color:var(--violeta);padding:.25rem .6rem;border-radius:100px}
    .auto-section{padding:10rem 4rem;position:relative;overflow:hidden;background:var(--negro)}
    .auto-bg{position:absolute;inset:0;z-index:0;opacity:0;transition:opacity 1.5s ease;overflow:hidden}
    .auto-section.revealed .auto-bg{opacity:1}
    .auto-bg-text{position:absolute;font-family:'Courier New',monospace;font-size:.7rem;color:var(--verde);opacity:0;white-space:nowrap;animation:fc 20s linear infinite;pointer-events:none}
    @keyframes fc{from{transform:translateY(100vh);opacity:0}10%{opacity:.15}90%{opacity:.15}to{transform:translateY(-20vh);opacity:0}}
    .auto-inner{position:relative;z-index:1}
    .auto-badge{display:inline-flex;align-items:center;gap:.6rem;background:rgba(188,255,71,.06);border:1px solid rgba(188,255,71,.2);padding:.5rem 1.2rem;border-radius:100px;font-size:.65rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(188,255,71,.7);margin-bottom:2.5rem;opacity:0;transform:translateY(10px);transition:opacity .8s ease,transform .8s ease}
    .auto-section.revealed .auto-badge{opacity:1;transform:translateY(0)}
    .auto-badge::before{content:'///';font-family:'Courier New',monospace;margin-right:.3rem;animation:gl 4s ease-in-out infinite}
    @keyframes gl{0%,90%,100%{opacity:1;transform:none}92%{opacity:.5;transform:skewX(-5deg)}94%{opacity:1}96%{opacity:.3;transform:skewX(3deg)}98%{opacity:1}}
    .auto-title{font-family:var(--fd);font-weight:800;font-size:clamp(2.5rem,6vw,5rem);line-height:.95;letter-spacing:-.04em;margin-bottom:1.5rem;opacity:0;transform:translateY(30px);transition:opacity 1s ease .2s,transform 1s ease .2s}
    .auto-section.revealed .auto-title{opacity:1;transform:translateY(0)}
    .auto-title .aa{-webkit-text-stroke:1px var(--verde);color:transparent}
    .auto-desc{font-size:1.05rem;opacity:0;line-height:1.7;max-width:580px;margin-bottom:4rem;color:rgba(245,240,232,.55);transform:translateY(20px);transition:opacity 1s ease .4s,transform 1s ease .4s}
    .auto-section.revealed .auto-desc{opacity:1;transform:translateY(0)}
    .auto-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;border:1px solid rgba(188,255,71,.1);opacity:0;transform:translateY(20px);transition:opacity 1s ease .6s,transform 1s ease .6s}
    .auto-section.revealed .auto-grid{opacity:1;transform:translateY(0)}
    .an{padding:2rem 1.75rem;border-right:1px solid rgba(188,255,71,.08);position:relative;overflow:hidden;transition:background .3s}
    .an:last-child{border-right:none}
    .an:hover{background:rgba(188,255,71,.04)}
    .an::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--verde),transparent);transform:translateX(-100%);transition:transform .6s ease}
    .an:hover::after{transform:translateX(0)}
    .ani{font-size:1.8rem;margin-bottom:1rem;display:block}
    .ann{font-family:var(--fd);font-weight:700;font-size:1rem;margin-bottom:.5rem;letter-spacing:-.01em}
    .and{font-size:.8rem;line-height:1.55;opacity:.45}
    .auto-ht{margin-top:5rem;padding-top:3rem;border-top:1px solid rgba(188,255,71,.08);display:flex;justify-content:space-between;align-items:center;gap:3rem;opacity:0;transform:translateY(15px);transition:opacity 1.2s ease .8s,transform 1.2s ease .8s}
    .auto-section.revealed .auto-ht{opacity:1;transform:translateY(0)}
    .auto-q{font-family:var(--fd);font-weight:700;font-size:clamp(1.2rem,2.5vw,2rem);letter-spacing:-.02em;line-height:1.2;max-width:500px;color:rgba(245,240,232,.25)}
    .auto-q .rw{color:var(--verde);opacity:0;display:inline-block;transition:opacity .5s ease}
    .auto-tools{display:flex;flex-wrap:wrap;gap:.5rem;justify-content:flex-end}
    .att{font-family:'Courier New',monospace;font-size:.65rem;letter-spacing:.05em;border:1px solid rgba(188,255,71,.2);color:rgba(188,255,71,.5);padding:.35rem .75rem;border-radius:4px;transition:all .3s}
    .att:hover{border-color:var(--verde);color:var(--verde);background:rgba(188,255,71,.05)}
    .process{padding:8rem 4rem}
    .pi{display:grid;grid-template-columns:80px 1fr 1fr;gap:2rem;align-items:center;padding:2.5rem 0;border-bottom:1px solid var(--gris2);transition:all .3s}
    .pi:hover{padding-left:1rem}
    .pi:hover .pn{color:var(--verde)}
    .pn{font-family:var(--fd);font-weight:800;font-size:3rem;color:var(--gris2);letter-spacing:-.05em;transition:color .3s}
    .pname{font-family:var(--fd);font-weight:700;font-size:1.5rem;letter-spacing:-.02em}
    .pdesc{font-size:.9rem;line-height:1.6;opacity:.5}
    .community{padding:8rem 4rem;background:var(--gris)}
    .ci{display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:center}
    .cs{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--gris2)}
    .stat{background:var(--gris);padding:2.5rem}
    .snum{font-family:var(--fd);font-weight:800;font-size:3.5rem;letter-spacing:-.04em;color:var(--verde);line-height:1;margin-bottom:.5rem}
    .slbl{font-size:.8rem;opacity:.5;line-height:1.4}
    .cta-section{padding:10rem 4rem;text-align:center;position:relative;overflow:hidden}
    .cta-section::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:700px;height:700px;background:radial-gradient(circle,rgba(37,211,102,.07) 0%,transparent 70%);pointer-events:none;animation:ctaGlow 4s ease-in-out infinite}
    @keyframes ctaGlow{0%,100%{transform:translate(-50%,-50%) scale(1)}50%{transform:translate(-50%,-50%) scale(1.08)}}
    .ctt{font-family:var(--fd);font-weight:800;font-size:clamp(2.5rem,7vw,7rem);line-height:.95;letter-spacing:-.04em;margin-bottom:2.5rem;position:relative;z-index:1}
    .ctt span{color:var(--verde)}
    .csub{font-size:1.1rem;opacity:.5;max-width:500px;margin:0 auto 1.5rem;line-height:1.6;position:relative;z-index:1}
    .cta-value{font-family:var(--fd);font-weight:700;font-size:1rem;color:var(--verde);opacity:.8;margin-bottom:3rem;position:relative;z-index:1;letter-spacing:.05em;text-transform:uppercase}
    .cta-value::before,.cta-value::after{content:'—';margin:0 .75rem;opacity:.4}
    footer{border-top:1px solid var(--gris2);padding:3rem 4rem;display:flex;justify-content:space-between;align-items:center}
    .fl{font-family:var(--fd);font-weight:800;font-size:1rem;color:var(--blanco);text-decoration:none}
    .fl span{color:var(--verde)}
    .flinks{display:flex;gap:2rem;list-style:none}
    .flinks a{color:var(--blanco);text-decoration:none;font-size:.75rem;opacity:.4;letter-spacing:.08em;text-transform:uppercase;transition:opacity .2s}
    .flinks a:hover{opacity:1}
    .fco{font-size:.7rem;opacity:.25}
    .reveal{opacity:0;transform:translateY(30px);transition:opacity .7s ease,transform .7s ease}

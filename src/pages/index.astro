    const curGlow=new THREE.Mesh(new THREE.CircleGeometry(0.06,16), new THREE.MeshBasicMaterial({color:0x9B5DFF,transparent:true,opacity:.5}));
    curGlow.position.set(-0.05,0.08,0.066); tabGrp.add(curGlow);

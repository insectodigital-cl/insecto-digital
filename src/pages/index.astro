    standGrp.position.set(0,-1.58,0); root.add(standGrp);
    // Base disc
    const base = new THREE.Mesh(new THREE.CylinderGeometry(0.35,0.4,0.06,32), new THREE.MeshStandardMaterial({color:0x1a1a1a,metalness:.7,roughness:.35}));
    standGrp.add(base);
    // Stand pole
    const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.04,0.05,0.38,14), darkMat);
    pole.position.y=0.22; standGrp.add(pole);
    // Stand top connector
    const conn = new THREE.Mesh(new THREE.CylinderGeometry(0.07,0.07,0.1,14), silverMat);
    conn.position.y=0.44; standGrp.add(conn);

    // ── CABLE ──
    const cablePts=[];
    for(let i=0;i<=24;i++){
      const f=i/24;
      cablePts.push(new THREE.Vector3(-1.1, -1.05-f*0.52, Math.sin(f*Math.PI*4)*0.04));
    }
    root.add(new THREE.Line(
      new THREE.BufferGeometry().setFromPoints(cablePts),
      new THREE.LineBasicMaterial({color:0x222,transparent:true,opacity:.8})
    ));

    // Center: band top ~1.3, stand bottom ~-1.64
    // Center y = (1.3-1.64)/2 = -0.17
    root.position.y = 0.2;
    camera.position.set(0, 0.1, 6.2);
    camera.lookAt(0, 0.1, 0);

    const clk=new THREE.Clock();
    (function loop(){
      requestAnimationFrame(loop); const t=clk.getElapsedTime();
      root.rotation.y = Math.sin(t*0.42)*0.35;
      root.rotation.x = Math.sin(t*0.28)*0.04;
      accentL.position.set(Math.cos(t*.4)*3,4,Math.sin(t*.4)*3+4);
      renderer.render(scene,camera);
    })();
  })();


  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script>
  // ════════════════════════════════════════════════════════
  // SHARED: transparent canvas over colored CSS background
  // Objects use MeshBasicMaterial with emissive-style colors
  // ════════════════════════════════════════════════════════
  function initCard(cid, wid) {
    const canvas = document.getElementById(cid);
    const wrap   = document.getElementById(wid);
    if (!canvas || !wrap) return null;
    const W = wrap.clientWidth || 560, H = wrap.clientHeight || 240;
    // TRANSPARENT renderer — CSS background shows through
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(W, H);
    renderer.setClearColor(0x000000, 0); // fully transparent
    const scene  = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, W / H, 0.1, 80);
    camera.position.set(0, 0, 5);
    camera.lookAt(0, 0, 0);
    new ResizeObserver(() => {
      const nw = wrap.clientWidth, nh = wrap.clientHeight;
      renderer.setSize(nw, nh);
      camera.aspect = nw / nh;
      camera.updateProjectionMatrix();
    }).observe(wrap);
    // Minimal ambient — objects rely on emissive color
    scene.add(new THREE.AmbientLight(0xffffff, 0.15));
    return { renderer, scene, camera };
  }

  // Helper: glowing line material
  function lineMat(hex, opacity) {
    return new THREE.LineBasicMaterial({ color: hex, transparent: true, opacity: opacity || 1.0 });
  }
  // Helper: emissive solid mesh material
  function emMat(hex, emissive, opacity) {
    return new THREE.MeshBasicMaterial({ color: hex, transparent: opacity < 1, opacity: opacity || 1.0 });
  }

  // ════════════════════════════════════════════════════════
  // 1. FOTOGRAFÍA — Mirrorless camera wireframe, orange glow
  //    Solid bright outlines on orange-tinted background
  //    Camera body + cylindrical lens + aperture + mount
  // ════════════════════════════════════════════════════════
  (function() {
    const s = initCard('c-foto','w-foto');
    if (!s) return;
    const { renderer, scene, camera } = s;

    const COL    = 0xFF8844;   // primary orange glow
    const COL2   = 0xFFBB77;   // bright highlight
    const COL3   = 0xFF4411;   // accent dark orange
    const WIRE   = 0.85;

    const root = new THREE.Group();
    scene.add(root);

    // Wireframe helper
    function addWireBox(w,h,d,col,op) {
      const g = new THREE.EdgesGeometry(new THREE.BoxGeometry(w,h,d));
      const m = new THREE.LineSegments(g, lineMat(col,op));
      return m;
    }
    function addWireCyl(rt,rb,h,seg,col,op) {
      const g = new THREE.EdgesGeometry(new THREE.CylinderGeometry(rt,rb,h,seg));
      const m = new THREE.LineSegments(g, lineMat(col,op));
      return m;
    }

    // BODY — solid fill + wireframe overlay
    const bodyFill = new THREE.Mesh(
      new THREE.BoxGeometry(1.9,1.22,0.72),
      emMat(0x200d06, COL, 1.0)
    );
    root.add(bodyFill);
    const bodyWire = addWireBox(1.9,1.22,0.72, COL2, WIRE);
    root.add(bodyWire);

    // Grip
    const gripFill = new THREE.Mesh(new THREE.BoxGeometry(0.35,1.12,0.80), emMat(0x180b04,COL,1));
    gripFill.position.set(1.08,-0.05,0); root.add(gripFill);
    const gripWire = addWireBox(0.35,1.12,0.80, COL2, 0.7);
    gripWire.position.set(1.08,-0.05,0); root.add(gripWire);

    // Top plate
    const topWire = addWireBox(1.9,0.08,0.72, COL2, 0.6);
    topWire.position.y = 0.65; root.add(topWire);

    // VF hump
    const vfWire = addWireBox(0.44,0.2,0.38, COL, 0.55);
    vfWire.position.set(-0.3,0.78,-0.17); root.add(vfWire);

    // Shutter (red dot — stands out)
    const shutDot = new THREE.Mesh(
      new THREE.SphereGeometry(0.09,12,8),
      emMat(0xff2200, COL3, 1)
    );
    shutDot.position.set(0.68,0.73,0.37); root.add(shutDot);

    // Dial circle
    const dialGeo = new THREE.EdgesGeometry(new THREE.CylinderGeometry(0.18,0.18,0.06,24));
    const dial = new THREE.LineSegments(dialGeo, lineMat(COL2, 0.7));
    dial.rotation.x=Math.PI/2; dial.position.set(-0.55,0.73,0); root.add(dial);

    // Mount ring (gold/orange)
    const mountGeo = new THREE.EdgesGeometry(new THREE.TorusGeometry(0.41,0.025,8,48));
    const mountWire = new THREE.LineSegments(mountGeo, lineMat(0xFFCC44, 0.95));
    mountWire.rotation.x=Math.PI/2; mountWire.position.set(0,0,0.37); root.add(mountWire);

    // LENS GROUP
    const lg = new THREE.Group(); lg.position.set(0,0,0.38); root.add(lg);

    // Barrel 1
    const b1Fill = new THREE.Mesh(new THREE.CylinderGeometry(0.4,0.4,0.3,32), emMat(0x200d06,COL,1));
    b1Fill.rotation.x=Math.PI/2; b1Fill.position.z=0.12; lg.add(b1Fill);
    const b1Wire = addWireCyl(0.4,0.4,0.3,24, COL2, WIRE);
    b1Wire.rotation.x=Math.PI/2; b1Wire.position.z=0.12; lg.add(b1Wire);

    // Focus ring lines (glowing ribs)
    for(let i=0;i<16;i++){
      const a=(i/16)*Math.PI*2;
      const pts=[
        new THREE.Vector3(Math.cos(a)*0.41, Math.sin(a)*0.41, 0.0),
        new THREE.Vector3(Math.cos(a)*0.41, Math.sin(a)*0.41, 0.24)
      ];
      const rg=new THREE.BufferGeometry().setFromPoints(pts);
      lg.add(new THREE.Line(rg, lineMat(COL, 0.4)));
    }

    // Barrel 2
    const b2Wire = addWireCyl(0.34,0.34,0.22,20, COL2, 0.75);
    b2Wire.rotation.x=Math.PI/2; b2Wire.position.z=0.35; lg.add(b2Wire);

    // Barrel 3
    const b3Wire = addWireCyl(0.28,0.28,0.16,20, COL, 0.7);
    b3Wire.rotation.x=Math.PI/2; b3Wire.position.z=0.53; lg.add(b3Wire);

    // Front frame ring (bright)
    const ffGeo = new THREE.EdgesGeometry(new THREE.TorusGeometry(0.26,0.02,8,40));
    const ff = new THREE.LineSegments(ffGeo, lineMat(COL2, 0.95));
    ff.rotation.x=Math.PI/2; ff.position.z=0.625; lg.add(ff);

    // Front glass disc (glowing)
    const glFill = new THREE.Mesh(new THREE.CircleGeometry(0.24,36), emMat(0x331100,COL,0.55));
    glFill.position.z=0.63; lg.add(glFill);
    // Glass inner glow
    const glInner = new THREE.Mesh(new THREE.CircleGeometry(0.1,24), emMat(0xFF8844,COL,0.3));
    glInner.position.z=0.632; lg.add(glInner);

    // Aperture blades (8 glowing lines)
    const bladeGroup = new THREE.Group(); bladeGroup.position.z=0.615; lg.add(bladeGroup);
    const blades=[];
    for(let i=0;i<8;i++){
      const a=(i/8)*Math.PI*2;
      const pts=[new THREE.Vector3(0,0,0), new THREE.Vector3(Math.cos(a)*0.22,Math.sin(a)*0.22,0)];
      const bg2=new THREE.BufferGeometry().setFromPoints(pts);
      const bl=new THREE.Line(bg2, lineMat(COL2, 0.85));
      bladeGroup.add(bl); blades.push({m:bl, a});
    }

    // Hotshoe line
    const shoeGeo=new THREE.EdgesGeometry(new THREE.BoxGeometry(0.26,0.04,0.17));
    const shoe=new THREE.LineSegments(shoeGeo, lineMat(COL, 0.5));
    shoe.position.set(-0.1,0.725,0); root.add(shoe);

    const clk=new THREE.Clock();
    (function loop(){
      requestAnimationFrame(loop); const t=clk.getElapsedTime();
      root.rotation.y = t*0.52;
      root.rotation.x = Math.sin(t*0.32)*0.06;
      // Aperture blades pulse
      const ap = Math.sin(t*1.2)*0.08+0.1;
      blades.forEach(({m,a})=>{
        const na=a+ap;
        const pos=m.geometry.attributes.position;
        pos.setXYZ(1, Math.cos(na)*0.22, Math.sin(na)*0.22, 0);
        pos.needsUpdate=true;
      });
      // Focus ring slow spin
      lg.children[2] && (lg.children[2].rotation.z = t*0.3);
      renderer.render(scene,camera);
    })();
  })();

  // ════════════════════════════════════════════════════════
  // 2. VIDEO — Cinema camera wireframe, magenta glow
  //    Large boxy body + big lens + top handle + EVF
  // ════════════════════════════════════════════════════════
  (function() {
    const s = initCard('c-video','w-video');
    if (!s) return;
    const { renderer, scene, camera } = s;

    const COL  = 0xFF3CAC;
    const COL2 = 0xFF88CC;
    const FILL = 0x18040d;

    const root = new THREE.Group();
    scene.add(root);

    function wBox(w,h,d,col,op){
      const g=new THREE.EdgesGeometry(new THREE.BoxGeometry(w,h,d));
      return new THREE.LineSegments(g, lineMat(col,op));
    }
    function fBox(w,h,d){
      return new THREE.Mesh(new THREE.BoxGeometry(w,h,d), emMat(FILL,COL,1.0));
    }
    function wCyl(r,h,seg,col,op){
      const g=new THREE.EdgesGeometry(new THREE.CylinderGeometry(r,r,h,seg));
      return new THREE.LineSegments(g, lineMat(col,op));
    }

    // Body
    root.add(fBox(1.9,1.1,1.0));
    const bw=wBox(1.9,1.1,1.0, COL2, 0.9); root.add(bw);

    // Panel grooves
    [-0.55,0.55].forEach(x=>{
      const g=wBox(0.015,1.13,1.03, COL, 0.3);
      g.position.x=x; root.add(g);
    });

    // Top handle
    root.add(fBox(1.48,0.14,0.78)).position.y=0.67;
    const hw=wBox(1.48,0.14,0.78, COL2, 0.85);
    hw.position.y=0.67; root.add(hw);

    // Handle struts
    [-0.5,0.5].forEach(x=>{
      const sw=wBox(0.11,0.22,0.08, COL, 0.5);
      sw.position.set(x,0.48,0); root.add(sw);
    });

    // EVF arm + monitor
    const armW=wBox(0.08,0.34,0.08, COL2, 0.7);
    armW.position.set(0.78,0.66,0.18); root.add(armW);
    root.add(fBox(0.52,0.32,0.045)).position.set(0.78,0.96,0.16);
    const monW=wBox(0.52,0.32,0.045, COL2, 0.85);
    monW.position.set(0.78,0.96,0.16); root.add(monW);
    // Screen glow
    const scrFill=new THREE.Mesh(new THREE.PlaneGeometry(0.45,0.27), emMat(0x330011,COL,0.7));
    scrFill.position.set(0.78,0.96,0.185); root.add(scrFill);

    // REC button (bright)
    const recDot=new THREE.Mesh(new THREE.SphereGeometry(0.07,12,8), emMat(0xff0000,0xff2200,1));
    recDot.position.set(0.6,0.61,0.52); root.add(recDot);
    // REC ring
    const recGeo=new THREE.EdgesGeometry(new THREE.TorusGeometry(0.085,0.01,6,24));
    const recRing=new THREE.LineSegments(recGeo, lineMat(0xff5500,0.8));
    recRing.rotation.x=Math.PI/2; recRing.position.set(0.6,0.61,0.525); root.add(recRing);

    // Lens mount
    const mntGeo=new THREE.EdgesGeometry(new THREE.TorusGeometry(0.46,0.028,8,48));
    const mnt=new THREE.LineSegments(mntGeo, lineMat(COL2,0.9));
    mnt.rotation.x=Math.PI/2; mnt.position.set(-0.1,0,0.52); root.add(mnt);

    // LENS
    const lg=new THREE.Group(); lg.position.set(-0.1,0,0.53); root.add(lg);

    // Barrel fill + wire
    lg.add(new THREE.Mesh(new THREE.CylinderGeometry(0.455,0.455,0.54,32), emMat(0x120408,COL,1.0))).rotation.x=Math.PI/2;
    lg.children[0].position.z=0.21;
    const lb1w=wCyl(0.455,0.54,24, COL2, 0.85);
    lb1w.rotation.x=Math.PI/2; lb1w.position.z=0.21; lg.add(lb1w);

    // Iris ring
    const irisGeo=new THREE.EdgesGeometry(new THREE.TorusGeometry(0.46,0.016,8,48));
    const iris=new THREE.LineSegments(irisGeo, lineMat(COL2, 0.95));
    iris.rotation.x=Math.PI/2; iris.position.z=0.42; lg.add(iris);

    // Front barrel
    const lb2w=wCyl(0.375,0.22,20, COL, 0.8);
    lb2w.rotation.x=Math.PI/2; lb2w.position.z=0.62; lg.add(lb2w);

    // Front frame
    const ffGeo=new THREE.EdgesGeometry(new THREE.TorusGeometry(0.355,0.022,8,44));
    const ff=new THREE.LineSegments(ffGeo, lineMat(COL2, 0.95));
    ff.rotation.x=Math.PI/2; ff.position.z=0.74; lg.add(ff);

    // Lens glass
    const lgl=new THREE.Mesh(new THREE.CircleGeometry(0.335,40), emMat(0x200010,COL,0.5));
    lgl.position.z=0.748; lg.add(lgl);
    const lglInner=new THREE.Mesh(new THREE.CircleGeometry(0.12,24), emMat(COL,COL,0.35));
    lglInner.position.z=0.75; lg.add(lglInner);

    // XLR ports
    [-0.16,0.16].forEach(y=>{
      const xg=new THREE.EdgesGeometry(new THREE.CylinderGeometry(0.05,0.05,0.09,12));
      const xl=new THREE.LineSegments(xg, lineMat(COL, 0.5));
      xl.rotation.z=Math.PI/2; xl.position.set(-1.0,y,-0.12); root.add(xl);
    });

    const clk=new THREE.Clock(); let rp=0;
    (function loop(){
      requestAnimationFrame(loop); const t=clk.getElapsedTime();
      root.rotation.y=t*0.48; root.rotation.x=Math.sin(t*0.28)*0.045;
      lb1w.rotation.z=t*0.2; iris.rotation.z=-t*0.35;
      rp+=0.04; recRing.material.opacity=0.4+Math.abs(Math.sin(rp))*0.55;
      recDot.material.opacity=0.7+Math.abs(Math.sin(rp+0.5))*0.3;
      renderer.render(scene,camera);
    })();
  })();

  // ════════════════════════════════════════════════════════
  // 3. HEADPHONES — over-ear, cyan wireframe glow
  //    REBUILT from scratch: proper arc + two cups
  //    Centered, large, clearly recognizable
  // ════════════════════════════════════════════════════════
  (function() {
    const s = initCard('c-audio','w-audio');
    if (!s) return;
    const { renderer, scene, camera } = s;

    const COL  = 0x2AFADF;
    const COL2 = 0x88FFEE;
    const FILL = 0x020d0c;

    const root = new THREE.Group();
    scene.add(root);

    // ── HEADBAND — torus arc, half circle ──
    // Using a tube along a curve for a clean arc
    const arcCurve = new THREE.QuadraticBezierCurve3(
      new THREE.Vector3(-1.1, 0, 0),
      new THREE.Vector3(0, 1.35, 0),
      new THREE.Vector3(1.1, 0, 0)
    );
    // Band fill (tube)
    const bandTube = new THREE.TubeGeometry(arcCurve, 30, 0.065, 10, false);
    root.add(new THREE.Mesh(bandTube, emMat(FILL, COL, 1.0)));
    // Band wire glow
    const bandEdge = new THREE.EdgesGeometry(bandTube);
    root.add(new THREE.LineSegments(bandEdge, lineMat(COL2, 0.85)));

    // Band pad (slightly thinner, offset)
    const padCurve = new THREE.QuadraticBezierCurve3(
      new THREE.Vector3(-1.04, 0.04, 0),
      new THREE.Vector3(0, 1.28, 0),
      new THREE.Vector3(1.04, 0.04, 0)
    );
    const padTube = new THREE.TubeGeometry(padCurve, 24, 0.045, 8, false);
    root.add(new THREE.Mesh(padTube, emMat(0x010808,COL,0.6)));

    // ── SLIDER RAILS (both sides) ──
    [-1.06, 1.06].forEach(x => {
      // Rail
      const railPts=[new THREE.Vector3(x,-0.02,0), new THREE.Vector3(x,-0.8,0)];
      const rg=new THREE.BufferGeometry().setFromPoints(railPts);
      root.add(new THREE.Line(rg, lineMat(COL, 0.6)));

      // Slider block
      const slGeo=new THREE.EdgesGeometry(new THREE.BoxGeometry(0.14,0.2,0.12));
      const sl=new THREE.LineSegments(slGeo, lineMat(COL2, 0.7));
      sl.position.set(x,-0.52,0); root.add(sl);
      const slFill=new THREE.Mesh(new THREE.BoxGeometry(0.12,0.18,0.1), emMat(FILL,COL,1));
      slFill.position.set(x,-0.52,0); root.add(slFill);

      // Yoke joint
      const ykGeo=new THREE.EdgesGeometry(new THREE.CylinderGeometry(0.1,0.1,0.13,16));
      const yk=new THREE.LineSegments(ykGeo, lineMat(COL2, 0.8));
      yk.rotation.z=Math.PI/2; yk.position.set(x,-0.92,0); root.add(yk);
      const ykFill=new THREE.Mesh(new THREE.CylinderGeometry(0.09,0.09,0.11,16), emMat(FILL,COL,1));
      ykFill.rotation.z=Math.PI/2; ykFill.position.set(x,-0.92,0); root.add(ykFill);

      // ── EAR CUP ──
      const cupGroup = new THREE.Group();
      cupGroup.position.set(x*1.02, -1.02, 0);
      root.add(cupGroup);

      // Cup outer shell (flat cylinder from the side)
      const cupFill=new THREE.Mesh(
        new THREE.CylinderGeometry(0.42,0.42,0.22,32),
        emMat(FILL, COL, 1.0)
      );
      cupFill.rotation.z=Math.PI/2; cupGroup.add(cupFill);

      // Cup wire outline
      const cupGeo=new THREE.EdgesGeometry(new THREE.CylinderGeometry(0.42,0.42,0.22,24));
      const cupWire=new THREE.LineSegments(cupGeo, lineMat(COL2, 0.9));
      cupWire.rotation.z=Math.PI/2; cupGroup.add(cupWire);

      // Rim circle (facing outward)
      const rimGeo=new THREE.EdgesGeometry(new THREE.TorusGeometry(0.4,0.025,8,40));
      const rimWire=new THREE.LineSegments(rimGeo, lineMat(COL, 0.95));
      rimWire.rotation.y=Math.PI/2; rimWire.position.x=x*0.005; cupGroup.add(rimWire);

      // Cushion torus
      const cushGeo=new THREE.EdgesGeometry(new THREE.TorusGeometry(0.3,0.075,8,36));
      const cush=new THREE.LineSegments(cushGeo, lineMat(COL, 0.55));
      cush.rotation.y=Math.PI/2; cush.position.x=-x*0.04; cupGroup.add(cush);

      // Driver circle
      const drvGeo=new THREE.EdgesGeometry(new THREE.CircleGeometry(0.22,24));
      const drv=new THREE.LineSegments(drvGeo, lineMat(COL2, 0.65));
      drv.rotation.y=x>0?Math.PI/2:-Math.PI/2; drv.position.x=x*0.02; cupGroup.add(drv);

      // Driver dome
      const domeGeo=new THREE.EdgesGeometry(new THREE.SphereGeometry(0.1,10,8,0,Math.PI*2,0,Math.PI*0.5));
      const dome=new THREE.LineSegments(domeGeo, lineMat(COL, 0.5));
      dome.rotation.y=x>0?Math.PI/2:-Math.PI/2; dome.position.x=x*0.03; cupGroup.add(dome);

      // Accent dot (bright cyan center)
      const dotMesh=new THREE.Mesh(new THREE.SphereGeometry(0.05,10,8), emMat(COL2,COL,0.9));
      dotMesh.position.x=x*0.14; cupGroup.add(dotMesh);
    });

    // ── CABLE from left cup ──
    const cablePts=[];
    for(let i=0;i<=20;i++){
      const f=i/20;
      cablePts.push(new THREE.Vector3(-1.06,-1.02-f*0.8, Math.sin(f*Math.PI*3)*0.05));
    }
    root.add(new THREE.Line(
      new THREE.BufferGeometry().setFromPoints(cablePts),
      lineMat(COL, 0.4)
    ));

    // Center: arc top ~y=1.35, cups at y=-1.02, cable goes to ~-1.82
    // Visual center ≈ (1.35 + (-1.02))/2 = 0.165
    root.position.y = -0.15;
    camera.position.set(0, 0, 5.8);
    camera.lookAt(0, 0, 0);

    const clk=new THREE.Clock();
    (function loop(){
      requestAnimationFrame(loop); const t=clk.getElapsedTime();
      root.rotation.y = t*0.5;
      root.rotation.x = Math.sin(t*0.3)*0.05;
      renderer.render(scene,camera);
    })();
  })();

  // ════════════════════════════════════════════════════════
  // 4. DIRECCIÓN DE ARTE — Stylus + screen, violeta glow
  //    Hand holding stylus over a glowing tablet screen
  //    with UI elements — wireframe + emissive style
  // ════════════════════════════════════════════════════════
  (function() {
    const s = initCard('c-arte','w-arte');
    if (!s) return;
    const { renderer, scene, camera } = s;

    const COL  = 0x9B5DFF;
    const COL2 = 0xBB99FF;
    const FILL = 0x060310;
    const ACCENT = 0xFF3CAC;

    const root = new THREE.Group();
    scene.add(root);

    // ── TABLET ──
    const tabG = new THREE.Group();
    tabG.position.set(0,-0.4,0);
    tabG.rotation.x = -0.22;
    root.add(tabG);

    // Bezel fill + wire
    tabG.add(new THREE.Mesh(new THREE.BoxGeometry(2.5,1.58,0.055), emMat(0x0a0618,COL,1)));
    const bezelW=new THREE.LineSegments(
      new THREE.EdgesGeometry(new THREE.BoxGeometry(2.5,1.58,0.055)),
      lineMat(COL2, 0.88)
    );
    tabG.add(bezelW);

    // Screen fill (glowing surface)
    const scrFill=new THREE.Mesh(new THREE.PlaneGeometry(2.32,1.44), emMat(0x080318,COL,0.85));
    scrFill.position.z=0.03; tabG.add(scrFill);

    // UI — artboard
    const artFill=new THREE.Mesh(new THREE.PlaneGeometry(1.45,1.08), emMat(0x12082a,COL,0.9));
    artFill.position.set(-0.28,-0.03,0.031); tabG.add(artFill);
    const artW=new THREE.LineSegments(
      new THREE.EdgesGeometry(new THREE.BoxGeometry(1.45,1.08,0.002)),
      lineMat(COL2, 0.6)
    );
    artW.position.set(-0.28,-0.03,0.031); tabG.add(artW);

    // Paint strokes on artboard (colored lines)
    const strokeDefs=[
      {col:0xFF6B2B, pts:[[-0.85,.22],[-0.35,.28],[-0.1,.15],[0.1,.25]]},
      {col:0xFF3CAC, pts:[[-0.9,-.0 ],[-0.5,-.05],[-.1,-.12],[0.08,-.04]]},
      {col:0x2AFADF, pts:[[-0.82,-.2],[-0.45,-.18],[-.05,-.25],[0.1,-.18]]},
      {col:0xBCFF47, pts:[[-0.78,-.38],[-.4,-.35],[-.08,-.42],[0.05,-.34]]},
    ];
    strokeDefs.forEach(({col,pts})=>{
      const v3=pts.map(([x,y])=>new THREE.Vector3(x+(-0.28),y+(-0.03),0.036));
      const g=new THREE.BufferGeometry().setFromPoints(v3);
      tabG.add(new THREE.Line(g, lineMat(col, 0.9)));
      // Thicker stroke: parallel offset
      const v3b=pts.map(([x,y])=>new THREE.Vector3(x+(-0.28),y+(-0.03)+0.02,0.036));
      const g2=new THREE.BufferGeometry().setFromPoints(v3b);
      tabG.add(new THREE.Line(g2, lineMat(col, 0.5)));
    });

    // Tool panel right
    const panFill=new THREE.Mesh(new THREE.PlaneGeometry(0.48,1.08), emMat(0x0d0a22,COL,0.85));
    panFill.position.set(0.94,-0.03,0.031); tabG.add(panFill);

    // Tool icons (colored dots)
    [0xFF6B2B,0xFF3CAC,0xBCFF47,0x2AFADF,0x9B5DFF,0xffffff].forEach((col,i)=>{
      const ic=new THREE.Mesh(new THREE.CircleGeometry(0.04,12), emMat(col,col,0.85));
      ic.position.set(0.94,0.36-i*0.13,0.036); tabG.add(ic);
    });

    // Color swatches bottom
    [0xFF6B2B,0xFF3CAC,0xBCFF47,0x2AFADF,0x9B5DFF,0xffffff].forEach((col,i)=>{
      const sw=new THREE.Mesh(new THREE.PlaneGeometry(0.1,0.055), emMat(col,col,0.9));
      sw.position.set(-0.5+i*0.13,-0.6,0.036); tabG.add(sw);
    });

    // Title bar
    const tbFill=new THREE.Mesh(new THREE.PlaneGeometry(2.32,0.1), emMat(0x120828,COL,0.8));
    tbFill.position.set(0,0.65,0.031); tabG.add(tbFill);
    [0xFF5F57,0xFFBD2E,0x28C840].forEach((col,i)=>{
      const d=new THREE.Mesh(new THREE.CircleGeometry(0.026,12), emMat(col,col,1));
      d.position.set(-1.08+i*0.072,0.65,0.036); tabG.add(d);
    });

    // Cursor (bright dot with crosshair)
    const curPos = new THREE.Vector3(-0.05,0.1,0.038);
    const curDot=new THREE.Mesh(new THREE.CircleGeometry(0.025,12), emMat(0xffffff,0xffffff,1));
    curDot.position.copy(curPos); tabG.add(curDot);
    const curGlow=new THREE.Mesh(new THREE.CircleGeometry(0.06,16), emMat(COL,COL,0.4));
    curGlow.position.copy(curPos); curGlow.position.z+=0.001; tabG.add(curGlow);
    // Crosshair
    [[0.1,0.006],[0.006,0.1]].forEach(([w,h])=>{
      const cr=new THREE.Mesh(new THREE.PlaneGeometry(w,h), emMat(COL2,COL2,0.6));
      cr.position.copy(curPos); cr.position.z+=0.002; tabG.add(cr);
    });

    // ── STYLUS ──
    const penG=new THREE.Group();
    penG.position.set(0.55,0.9,0.55);
    penG.rotation.set(-0.55,-0.22,0.4);
    root.add(penG);

    // Pen barrel fill
    penG.add(new THREE.Mesh(new THREE.CylinderGeometry(0.05,0.038,1.18,12), emMat(0x1a0d2e,COL,1)));
    // Pen barrel wire
    const pbW=new THREE.LineSegments(
      new THREE.EdgesGeometry(new THREE.CylinderGeometry(0.05,0.038,1.18,12)),
      lineMat(COL2, 0.8)
    );
    penG.add(pbW);

    // Grip section (darker)
    penG.add(new THREE.Mesh(new THREE.CylinderGeometry(0.052,0.048,0.32,12), emMat(0x0e0818,COL,1))).position.y=-0.3;
    // Grip ribs
    for(let i=0;i<7;i++){
      const rg=new THREE.EdgesGeometry(new THREE.TorusGeometry(0.053,0.004,6,14));
      const rb=new THREE.LineSegments(rg, lineMat(COL, 0.5));
      rb.position.y=-0.17+i*0.04; penG.add(rb);
    }

    // Side button
    const btnFill=new THREE.Mesh(new THREE.BoxGeometry(0.018,0.075,0.058), emMat(COL,COL,1));
    btnFill.position.set(0.053,0.1,0); penG.add(btnFill);

    // Nib taper fill + wire
    penG.add(new THREE.Mesh(new THREE.CylinderGeometry(0.004,0.05,0.12,8), emMat(0x2a1855,COL,1))).position.y=-0.65;
    const nibW=new THREE.LineSegments(
      new THREE.EdgesGeometry(new THREE.CylinderGeometry(0.004,0.05,0.12,8)),
      lineMat(COL2, 0.85)
    );
    nibW.position.y=-0.65; penG.add(nibW);

    // Nib tip glow dot
    const nibDot=new THREE.Mesh(new THREE.SphereGeometry(0.02,10,8), emMat(COL2,COL2,1));
    nibDot.position.y=-0.715; penG.add(nibDot);
    const nibGlow=new THREE.Mesh(new THREE.SphereGeometry(0.045,10,8), emMat(COL,COL,0.4));
    nibGlow.position.y=-0.715; penG.add(nibGlow);

    // Top cap
    penG.add(new THREE.Mesh(new THREE.SphereGeometry(0.042,12,10), emMat(0x333,COL,0.8))).position.y=0.635;
    const capW=new THREE.LineSegments(
      new THREE.EdgesGeometry(new THREE.CylinderGeometry(0.038,0.038,0.05,12)),
      lineMat(COL, 0.6)
    );
    capW.position.y=0.63; penG.add(capW);

    // Center
    root.position.set(0,0.12,0);
    camera.position.set(0,0.12,5.2);
    camera.lookAt(0,0.12,0);

    const clk=new THREE.Clock();
    (function loop(){
      requestAnimationFrame(loop); const t=clk.getElapsedTime();
      root.rotation.y=t*0.42;
      root.rotation.x=Math.sin(t*0.26)*0.04;
      // Cursor pulse
      curGlow.material.opacity=0.25+Math.abs(Math.sin(t*2))*0.3;
      curDot.scale.setScalar(1+Math.sin(t*2)*0.15);
      // Nib glow pulse
      nibGlow.material.opacity=0.3+Math.abs(Math.sin(t*1.8))*0.3;
      nibDot.scale.setScalar(1+Math.sin(t*1.8)*0.2);
      renderer.render(scene,camera);
    })();
  })();

  // ════════════════════════════════════════════════════════
  // HERO 3D — unchanged, particles + wireframe shapes
  // ════════════════════════════════════════════════════════
  (function(){
    const canvas=document.getElementById('hero-canvas');
    const renderer=new THREE.WebGLRenderer({canvas,antialias:true,alpha:true});
    renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
    renderer.setClearColor(0x000000,0);
    const scene=new THREE.Scene();
    const camera=new THREE.PerspectiveCamera(60,1,.1,100);
    camera.position.set(0,0,5);
    function resize(){const w=canvas.parentElement.clientWidth,h=canvas.parentElement.clientHeight;renderer.setSize(w,h);camera.aspect=w/h;camera.updateProjectionMatrix();}
    resize();window.addEventListener('resize',resize);
    const mkP=(n,sp,col,sz,op)=>{
      const p=new Float32Array(n*3);
      for(let i=0;i<n;i++){p[i*3]=(Math.random()-.5)*sp;p[i*3+1]=(Math.random()-.5)*sp;p[i*3+2]=(Math.random()-.5)*(sp*.7);}
      const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(p,3));
      return new THREE.Points(g,new THREE.PointsMaterial({color:col,size:sz,transparent:true,opacity:op,sizeAttenuation:true}));
    };
    scene.add(mkP(1800,20,0xBCFF47,.03,.6));
    scene.add(mkP(600,18,0xFF3CAC,.025,.35));
    scene.add(mkP(400,16,0x2AFADF,.02,.25));
    const ag=(geo,col,op)=>{const m=new THREE.Mesh(geo,new THREE.MeshBasicMaterial({color:col,wireframe:true,transparent:true,opacity:op}));scene.add(m);return m;};
    const ico=ag(new THREE.IcosahedronGeometry(1.2,1),0xBCFF47,.08);ico.position.set(2.5,.5,0);
    const oct=ag(new THREE.OctahedronGeometry(.7,0),0xFF3CAC,.12);oct.position.set(-3,-.8,-1);
    const tet=ag(new THREE.TetrahedronGeometry(.5,0),0x2AFADF,.15);tet.position.set(-1.5,1.5,-2);
    const tor=ag(new THREE.TorusGeometry(.6,.08,8,24),0x9B5DFF,.1);tor.position.set(1,-1.8,-1.5);
    let mouseX=0,mouseY=0,tX=0,tY=0,scrollY=0;
    document.addEventListener('mousemove',e=>{mouseX=(e.clientX/window.innerWidth-.5)*2;mouseY=-(e.clientY/window.innerHeight-.5)*2;});
    window.addEventListener('scroll',()=>{scrollY=window.scrollY;});
    const clk=new THREE.Clock();
    (function loop(){
      requestAnimationFrame(loop);const t=clk.getElapsedTime();
      tX+=(mouseX-tX)*.05;tY+=(mouseY-tY)*.05;
      camera.position.x=tX*.4;camera.position.y=tY*.2;
      const sp=Math.min(scrollY/(canvas.parentElement.clientHeight||window.innerHeight),1);
      camera.position.z=5-sp*2.5;camera.rotation.z=sp*.1;
      scene.children[0].rotation.y=t*.04;scene.children[0].rotation.x=t*.02;
      scene.children[1].rotation.y=-t*.03;scene.children[2].rotation.x=t*.05;
      ico.rotation.x=t*.3+tY*.5;ico.rotation.y=t*.4+tX*.5;ico.position.y=.5+Math.sin(t*.7)*.3;
      oct.rotation.x=-t*.5;oct.rotation.z=t*.3;oct.position.y=-.8+Math.cos(t*.5)*.25;
      tet.rotation.y=t*.8;tet.rotation.x=t*.6;tet.position.x=-1.5+Math.sin(t*.4)*.2;
      tor.rotation.x=t*.4;tor.rotation.y=t*.6;tor.position.y=-1.8+Math.sin(t*.8)*.2;
      renderer.render(scene,camera);
    })();
  })();

  // CURSOR
  const cur=document.getElementById('cursor'),cf=document.getElementById('cf');
  let mx=0,my=0,fx=0,fy=0;
  document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cur.style.left=mx+'px';cur.style.top=my+'px';});
  (function a(){fx+=(mx-fx)*.12;fy+=(my-fy)*.12;cf.style.left=fx+'px';cf.style.top=fy+'px';requestAnimationFrame(a);})();
  document.querySelectorAll('a,button').forEach(el=>{
    el.addEventListener('mouseenter',()=>{cur.style.width='20px';cur.style.height='20px';cf.style.width='60px';cf.style.height='60px';});
    el.addEventListener('mouseleave',()=>{cur.style.width='12px';cur.style.height='12px';cf.style.width='36px';cf.style.height='36px';});
  });
  window.addEventListener('scroll',()=>document.getElementById('mainNav').classList.toggle('scrolled',window.scrollY>80));
  const obs=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting)x.target.classList.add('visible');}),{threshold:.08});
  document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));
  document.querySelectorAll('.hero .reveal').forEach(el=>setTimeout(()=>el.classList.add('visible'),100));
  const autoSec=document.querySelector('.auto-section');
  if(autoSec){
    const ao=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting){
      autoSec.classList.add('revealed');
      ['rw1','rw2','rw3','rw4'].forEach((id,i)=>setTimeout(()=>{const el=document.getElementById(id);if(el)el.style.opacity='1';},1200+i*200));
      ao.disconnect();
    }});},{threshold:.2});
    ao.observe(autoSec);
  }
  </script>
</body>
</html>

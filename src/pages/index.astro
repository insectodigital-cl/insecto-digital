      sBtn.position.set(0.055,y,0); penGrp.add(sBtn);
    });

    // Ferrule (metal band)
    const ferrule=new THREE.Mesh(new THREE.CylinderGeometry(0.042,0.042,0.08,14), silverMat);
    ferrule.position.y=-0.53; penGrp.add(ferrule);

    // Nib (tapered metal tip)
    const nib=new THREE.Mesh(new THREE.CylinderGeometry(0.005,0.04,0.14,10), silverMat);
    nib.position.y=-0.68; penGrp.add(nib);

    // Nib glow (active tip)
    const nibGlow=new THREE.Mesh(new THREE.SphereGeometry(0.02,10,8), new THREE.MeshBasicMaterial({color:0x9B5DFF,transparent:true,opacity:.8}));
    nibGlow.position.y=-0.75; penGrp.add(nibGlow);

    // Top cap (eraser end — slightly different material)
    const cap=new THREE.Mesh(new THREE.CylinderGeometry(0.038,0.04,0.07,14), new THREE.MeshStandardMaterial({color:0x444,metalness:.7,roughness:.3}));
